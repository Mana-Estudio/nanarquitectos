---
import '../styles/global.css';
import { Image } from 'astro:assets';
import logo from '../assets/logo.webp';

interface Props {
  title: string;
  description?: string;
  overlay?: boolean;
  ogImage?: string;
}
const {
  title,
  description = 'NAN Arquitectos: estudio de arquitectura, interiorismo y gestión de obra en Pontevedra desde 2013.',
  overlay = false,
  ogImage,
} = Astro.props;
const fullTitle = title === 'NAN Arquitectos' ? 'NAN Arquitectos · Arquitectura e interiorismo en Pontevedra' : `${title} · NAN Arquitectos`;
const path = Astro.url.pathname;
const nav = [
  { href: '/proyectos/', label: 'Proyectos' },
  { href: '/#estudio', label: 'Estudio' },
  { href: '/#servicios', label: 'Servicios' },
  { href: '/#contacto', label: 'Contacto' },
];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.url)} />}
    <script is:inline>
      // ?motion=1 fuerza las animaciones aunque el sistema pida reducir movimiento (para demos)
      try {
        if (new URLSearchParams(location.search).has('motion')) sessionStorage.setItem('force-motion', '1');
        if (sessionStorage.getItem('force-motion')) document.documentElement.classList.add('force-motion');
      } catch (e) {}
    </script>
    <meta name="theme-color" content="#f4f1ec" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'ProfessionalService',
      name: 'NAN Arquitectos',
      foundingDate: '2013',
      telephone: '+34 691 563 366',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Plaza de España, 1, 1º Izquierda, oficina 2',
        postalCode: '36002',
        addressLocality: 'Pontevedra',
        addressCountry: 'ES',
      },
    })} />
  </head>
  <body>
    <a class="skip sr-only" href="#main">Saltar al contenido</a>
    <header class:list={['site-header', { overlay }]} data-header data-overlay={String(overlay)}>
      <a href="/" class="brand" aria-label="NAN Arquitectos, inicio">
        <Image src={logo} alt="NAN Arquitectos" width={190} height={88} loading="eager" />
      </a>
      <nav class="nav" data-menu aria-label="Principal">
        {nav.map((n) => (
          <a href={n.href} class="link-line" aria-current={path.startsWith(n.href) && n.href !== '/' ? 'page' : undefined}>{n.label}</a>
        ))}
      </nav>
      <button class="menu-btn" data-menu-toggle aria-expanded="false" aria-label="Abrir menú">
        <span></span><span></span>
      </button>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer wrap" id="contacto">
      <div class="footer-cta" data-reveal="text">
        <h2>Contanos qué querés construir.</h2>
        <a class="mail link-line" href="tel:+34691563366">+34 691 563 366</a>
      </div>
      <div class="footer-grid" data-reveal="text">
        <div>
          <p class="label">Estudio</p>
          <p>Plaza de España, 1, 1º Izq., oficina 2<br />36002 Pontevedra</p>
        </div>
        <div>
          <p class="label">Redes</p>
          <p>
            <a class="link-line" href="https://www.instagram.com/nanarquitectos/" target="_blank" rel="noopener">Instagram</a><br />
            <a class="link-line" href="https://www.pinterest.es/nanarquitectos/" target="_blank" rel="noopener">Pinterest</a>
          </p>
        </div>
        <div>
          <p class="label">Legal</p>
          <p>Nan Arquitectos y Contract S.L.<br />© {new Date().getFullYear()}</p>
        </div>
      </div>
    </footer>

    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>

<style>
  .skip:focus { position: fixed; top: 1rem; left: 1rem; width: auto; height: auto; clip: auto; z-index: 100; background: var(--ink); color: var(--paper); padding: 0.5rem 1rem; }

  .site-header {
    position: fixed; inset: 0 0 auto; z-index: 50;
    height: var(--header-h);
    display: flex; align-items: center; justify-content: space-between;
    padding-inline: var(--gutter);
    color: var(--ink);
    transition: background-color 0.6s var(--ease-out), color 0.6s var(--ease-out), box-shadow 0.6s var(--ease-out);
  }
  .site-header.is-solid {
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: blur(14px);
    box-shadow: 0 1px 0 var(--line);
  }
  .brand img { width: 96px; height: auto; transition: filter 0.6s var(--ease-out); }
  .site-header.overlay:not(.is-solid) { color: #fff; }
  .site-header.overlay:not(.is-solid) .brand img { filter: brightness(0) invert(1); }

  .nav { display: flex; gap: clamp(1.5rem, 3vw, 3rem); font-size: 0.875rem; letter-spacing: 0.01em; }
  .nav a[aria-current='page'] { background-size: 100% 1px; }

  .menu-btn { display: none; }

  @media (max-width: 760px) {
    .menu-btn {
      display: grid; gap: 7px; place-content: center;
      width: 44px; height: 44px; margin-right: -10px;
      background: none; border: 0; cursor: pointer; position: relative; z-index: 2;
    }
    .menu-btn span { display: block; width: 24px; height: 1.5px; background: currentColor; transition: transform 0.5s var(--ease-out); }
    :global(.menu-open) .menu-btn span:first-child { transform: translateY(4.25px) rotate(45deg); }
    :global(.menu-open) .menu-btn span:last-child { transform: translateY(-4.25px) rotate(-45deg); }

    .nav {
      position: fixed; inset: 0; z-index: 1;
      flex-direction: column; justify-content: center; gap: 1.25rem;
      padding: var(--gutter);
      background: var(--paper); color: var(--ink);
      font-family: var(--serif); font-size: 2.75rem; letter-spacing: -0.02em;
      clip-path: inset(0 0 100% 0);
      transition: clip-path 0.8s var(--ease-out);
    }
    :global(.menu-open) .nav { clip-path: inset(0 0 0 0); }
    :global(.menu-open) .site-header { color: var(--ink); }
    :global(.menu-open) .site-header .brand img { filter: none; position: relative; z-index: 2; }
  }

  .site-footer {
    background: var(--ink); color: var(--paper);
    padding-block: clamp(5rem, 12vw, 10rem) 3rem;
  }
  .site-footer .label { color: #a39e94; margin-bottom: 0.75rem; }
  .footer-cta h2 { font-size: clamp(2.5rem, 7vw, 6rem); max-width: 14ch; margin-bottom: 2rem; }
  .mail { font-size: clamp(1.25rem, 2vw, 1.5rem); }
  .footer-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 2rem;
    margin-top: clamp(4rem, 10vw, 8rem); padding-top: 2rem;
    border-top: 1px solid #3a3833; font-size: 0.9375rem; color: #d8d3c9;
  }
</style>
