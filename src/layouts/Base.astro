---
import { r } from '../lib/ruta';
import '../styles/global.css';
import { Image } from 'astro:assets';
import logo from '../assets/logo.webp';
import Cotizador from '../components/Cotizador.astro';
import Loader from '../components/Loader.astro';
import FirmaMana from '../components/FirmaMana.astro';
import { contacto } from '../data/estudio';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  current?: 'proyectos' | 'estudio' | 'servicios' | 'blog' | 'contacto';
  /** 'article' en las entradas del blog (Open Graph) */
  type?: 'website' | 'article';
}
const {
  title,
  description = 'NAN Arquitectos: estudio de arquitectura e interiorismo en Pontevedra. Clínicas, restaurantes, comercios, oficinas y viviendas en Galicia.',
  ogImage,
  current,
  type = 'website',
} = Astro.props;
// Con `site` en astro.config apunta al dominio definitivo; sin él, al host desde el que se sirve
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
// El prototipo (vercel.app) copia los textos de la web actual: fuera de Google hasta publicarlo en su dominio
const indexable = Astro.site?.hostname.endsWith('nanarquitectos.com') ?? false;
const fullTitle = title === 'NAN Arquitectos' ? 'NAN Arquitectos · Arquitectura e interiorismo en Pontevedra' : `${title} · NAN Arquitectos`;
const nav = [
  { id: 'proyectos', href: r('/proyectos/'), label: 'Proyectos' },
  { id: 'estudio', href: r('/estudio/'), label: 'Estudio' },
  { id: 'servicios', href: r('/servicios/'), label: 'Servicios' },
  { id: 'blog', href: r('/blog/'), label: 'Blog' },
  { id: 'contacto', href: r('/contacto/'), label: 'Contacto' },
];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="NAN Arquitectos" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, canonical)} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <link rel="alternate" type="application/rss+xml" title="Blog de NAN Arquitectos" href={r('/blog/rss.xml')} />
    <slot name="head" />
    <meta name="theme-color" content="#f5f3ef" />
    <link rel="icon" href={r('/favicon.svg')} type="image/svg+xml" />
    <script is:inline>
      // ?motion=1 fuerza las animaciones aunque el sistema pida reducir movimiento (para demos)
      try {
        var q = new URLSearchParams(location.search), html = document.documentElement;
        if (q.has('motion')) sessionStorage.setItem('force-motion', '1');
        var force = sessionStorage.getItem('force-motion');
        if (force) html.classList.add('force-motion');
        // Intro con fotos (components/Loader.astro): primera página de la visita, o ?intro para enseñarla
        var quiet = matchMedia('(prefers-reduced-motion: reduce)').matches && !force;
        if (!quiet && (q.has('intro') || !sessionStorage.getItem('intro-vista'))) {
          html.classList.add('is-loading');
          sessionStorage.setItem('intro-vista', '1');
          // Si el JavaScript de la página no llega a arrancarla, se retira sola
          setTimeout(function () { if (!document.querySelector('[data-loader][data-run]')) html.classList.remove('is-loading'); }, 4000);
        }
      } catch (e) {}
    </script>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'ProfessionalService',
      name: 'NAN Arquitectos',
      foundingDate: '2013',
      telephone: '+34 691 563 366',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Plaza de España, 1, 1º Izquierda, oficina 2',
        postalCode: '36002',
        addressLocality: 'Pontevedra',
        addressCountry: 'ES',
      },
    })} />
  </head>
  <body>
    <Loader />
    <a class="skip sr-only" href="#main">Saltar al contenido</a>
    <header class="site-header pad">
      <a href={r('/')} class="brand" aria-label="NAN Arquitectos, inicio">
        <Image src={logo} alt="NAN Arquitectos" width={190} height={88} loading="eager" />
      </a>
      <nav class="nav" id="menu" data-menu aria-label="Principal">
        {nav.map((n) => (
          <a href={n.href} class:list={['nav-a', { 'is-current': current === n.id }]} aria-current={current === n.id ? 'page' : undefined}>{n.label}</a>
        ))}
        <button class="nav-cta" data-quote>Pedir presupuesto</button>
        <p class="menu-foot small"><a href="tel:+34691563366">+34 691 563 366</a></p>
      </nav>
      <button class="menu-btn" data-menu-toggle aria-expanded="false" aria-controls="menu">Menú</button>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer pad small mut">
      <span>© {new Date().getFullYear()} NAN Arquitectos · Pontevedra, Galicia</span>
      <div class="foot-links">
        <a href={r('/publicaciones/')} class="ulink">Publicaciones</a>
        <a href={r('/blog/')} class="ulink">Blog</a>
        <a href={`mailto:${contacto.email}`} class="ulink">{contacto.email}</a>
        <a href={contacto.nuevos.href} class="ulink">{contacto.nuevos.tel}</a>
        {contacto.redes.slice(0, 2).map((r) => <a href={r.href} target="_blank" rel="noopener" class="ulink">{r.label}</a>)}
        <a href="https://www.nanarquitectos.com/aviso-legal/" target="_blank" rel="noopener">Aviso legal</a>
        <a href="https://www.nanarquitectos.com/politica-de-privacidad/" target="_blank" rel="noopener">Privacidad</a>
        <FirmaMana cliente="nanarquitectos" />
      </div>
    </footer>

    <Cotizador />

    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>

<style>
  .skip:focus { position: fixed; top: 1rem; left: 1rem; width: auto; height: auto; clip: auto; z-index: 100; background: var(--ink); color: var(--bg); padding: 0.5rem 1rem; }

  .site-header {
    position: relative; z-index: 50;
    height: var(--head-h);
    display: flex; align-items: center; justify-content: space-between;
  }
  .brand img { width: 92px; height: auto; }
  .nav { display: flex; align-items: center; gap: 40px; font-size: 14px; }
  .nav-a:not(.is-current) { background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat; padding-bottom: 3px; transition: background-size 0.6s var(--ease-out); }
  .nav-a:not(.is-current):hover { background-size: 100% 1px; color: var(--ink); }
  .nav-cta { padding: 10px 16px; margin: -10px 0; box-shadow: inset 0 0 0 1px var(--line); transition: background-color 0.4s, color 0.4s, box-shadow 0.4s; }
  .nav-cta:hover { background: var(--ink); color: var(--bg); box-shadow: inset 0 0 0 1px var(--ink); }
  .menu-btn, .menu-foot { display: none; }
  @media (max-width: 1100px) and (min-width: 761px) { .nav { gap: 28px; } }

  @media (max-width: 760px) {
    .brand { position: relative; z-index: 2; }
    .brand img { width: 76px; }
    .menu-btn { display: block; position: relative; z-index: 2; padding: 12px 0; font-size: 14px; }
    .nav {
      position: fixed; inset: 0; z-index: 1;
      flex-direction: column; gap: 6px;
      padding: calc(var(--head-h) + 56px) var(--pad) 32px;
      background: var(--bg);
      font-family: var(--serif); font-weight: 300; font-size: 44px; line-height: 1.15;
      clip-path: inset(0 0 100% 0);
      transition: clip-path 0.7s var(--ease-out);
    }
    :global(.menu-open) .nav { clip-path: inset(0 0 0 0); }
    @media (prefers-reduced-motion: reduce) {
      :global(html:not(.force-motion)) .nav { clip-path: none; opacity: 0; visibility: hidden; transition: opacity 0.2s, visibility 0s 0.2s; }
      :global(html.menu-open:not(.force-motion)) .nav { opacity: 1; visibility: visible; transition: opacity 0.2s; }
    }
    .menu-foot { display: block; margin-top: auto; font-family: var(--sans); font-size: 14px; }
    .nav-cta { align-self: flex-start; margin: 24px 0 0; padding: 14px 20px; font-family: var(--sans); font-size: 15px; background: var(--ink); color: var(--bg); }
  }

  .site-footer {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px 32px;
    padding-top: 28px; padding-bottom: 40px;
    border-top: 1px solid var(--line);
  }
  .foot-links { display: flex; flex-wrap: wrap; gap: 12px 24px; }
</style>
