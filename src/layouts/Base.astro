---
import '../styles/global.css';
import { Image } from 'astro:assets';
import logo from '../assets/logo.webp';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  current?: 'proyectos' | 'estudio' | 'servicios' | 'contacto';
}
const {
  title,
  description = 'NAN Arquitectos: estudio de arquitectura e interiorismo en Pontevedra. Clínicas, restaurantes, comercios, oficinas y viviendas en Galicia.',
  ogImage,
  current,
} = Astro.props;
const fullTitle = title === 'NAN Arquitectos' ? 'NAN Arquitectos · Arquitectura e interiorismo en Pontevedra' : `${title} · NAN Arquitectos`;
const nav = [
  { id: 'proyectos', href: '/proyectos/', label: 'Proyectos' },
  { id: 'estudio', href: '/#estudio', label: 'Estudio' },
  { id: 'servicios', href: '/#servicios', label: 'Servicios' },
  { id: 'contacto', href: '/#contacto', label: 'Contacto' },
];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.url)} />}
    <meta name="theme-color" content="#f5f3ef" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // ?motion=1 fuerza las animaciones aunque el sistema pida reducir movimiento (para demos)
      try {
        if (new URLSearchParams(location.search).has('motion')) sessionStorage.setItem('force-motion', '1');
        if (sessionStorage.getItem('force-motion')) document.documentElement.classList.add('force-motion');
      } catch (e) {}
    </script>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'ProfessionalService',
      name: 'NAN Arquitectos',
      foundingDate: '2013',
      telephone: '+34 691 563 366',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Plaza de España, 1, 1º Izquierda, oficina 2',
        postalCode: '36002',
        addressLocality: 'Pontevedra',
        addressCountry: 'ES',
      },
    })} />
  </head>
  <body>
    <a class="skip sr-only" href="#main">Saltar al contenido</a>
    <header class="site-header pad">
      <a href="/" class="brand" aria-label="NAN Arquitectos, inicio">
        <Image src={logo} alt="NAN Arquitectos" width={190} height={88} loading="eager" />
      </a>
      <nav class="nav" id="menu" data-menu aria-label="Principal">
        {nav.map((n) => (
          <a href={n.href} class:list={{ 'is-current': current === n.id }} aria-current={current === n.id ? 'page' : undefined}>{n.label}</a>
        ))}
        <p class="menu-foot small"><a href="tel:+34691563366">+34 691 563 366</a></p>
      </nav>
      <button class="menu-btn" data-menu-toggle aria-expanded="false" aria-controls="menu">Menú</button>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer pad small mut">
      <span>© {new Date().getFullYear()} NAN Arquitectos · Pontevedra, Galicia</span>
      <div class="foot-links">
        <a href="https://www.instagram.com/nanarquitectos/" target="_blank" rel="noopener">Instagram</a>
        <a href="https://www.pinterest.es/nanarquitectos/" target="_blank" rel="noopener">Pinterest</a>
        <a href="https://www.nanarquitectos.com/aviso-legal/" target="_blank" rel="noopener">Aviso legal</a>
        <a href="https://www.nanarquitectos.com/politica-de-privacidad/" target="_blank" rel="noopener">Privacidad</a>
      </div>
    </footer>

    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>

<style>
  .skip:focus { position: fixed; top: 1rem; left: 1rem; width: auto; height: auto; clip: auto; z-index: 100; background: var(--ink); color: var(--bg); padding: 0.5rem 1rem; }

  .site-header {
    position: relative; z-index: 50;
    height: var(--head-h);
    display: flex; align-items: center; justify-content: space-between;
  }
  .brand img { width: 92px; height: auto; }
  .nav { display: flex; gap: 40px; font-size: 14px; }
  .menu-btn, .menu-foot { display: none; }

  @media (max-width: 760px) {
    .brand { position: relative; z-index: 2; }
    .brand img { width: 76px; }
    .menu-btn { display: block; position: relative; z-index: 2; padding: 12px 0; font-size: 14px; }
    .nav {
      position: fixed; inset: 0; z-index: 1;
      flex-direction: column; gap: 6px;
      padding: calc(var(--head-h) + 56px) var(--pad) 32px;
      background: var(--bg);
      font-family: var(--serif); font-weight: 300; font-size: 44px; line-height: 1.15;
      clip-path: inset(0 0 100% 0);
      transition: clip-path 0.7s var(--ease-out);
    }
    :global(.menu-open) .nav { clip-path: inset(0 0 0 0); }
    @media (prefers-reduced-motion: reduce) {
      :global(html:not(.force-motion)) .nav { clip-path: none; opacity: 0; visibility: hidden; transition: opacity 0.2s, visibility 0s 0.2s; }
      :global(html.menu-open:not(.force-motion)) .nav { opacity: 1; visibility: visible; transition: opacity 0.2s; }
    }
    .menu-foot { display: block; margin-top: auto; font-family: var(--sans); font-size: 14px; }
  }

  .site-footer {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px 32px;
    padding-top: 28px; padding-bottom: 40px;
    border-top: 1px solid var(--line);
  }
  .foot-links { display: flex; flex-wrap: wrap; gap: 12px 24px; }
</style>
