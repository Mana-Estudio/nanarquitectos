---
import Base from '../layouts/Base.astro';
---
<Base title="Página no encontrada">
  <section class="pad nf">
    <h1>Esta página no existe.</h1>
    <p class="mut">Puede que el proyecto haya cambiado de dirección. Todo el trabajo del estudio está en el listado.</p>
    <p class="links"><a href="/proyectos/" class="is-current">Ver proyectos</a><a href="/">Inicio</a></p>
  </section>
</Base>

<style>
  .nf { padding-block: 120px var(--sec); max-width: 900px; }
  h1 { font-size: clamp(46px, 7.2vw, 104px); line-height: 1.02; letter-spacing: -0.02em; margin-bottom: 32px; }
  .links { display: flex; gap: 32px; margin-top: 40px; font-size: 14px; }
</style>
