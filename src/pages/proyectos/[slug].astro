---
import Base from '../../layouts/Base.astro';
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { proyectos, portada, ciudad, filtros, tipo } from '../../data/proyectos';

export function getStaticPaths() {
  return proyectos.map((p, i) => ({
    params: { slug: p.slug },
    props: { p, next: proyectos[(i + 1) % proyectos.length] },
  }));
}

const { p, next } = Astro.props;
const hero = portada(p);
const resto = p.fotos.filter((f) => f !== hero);
const isL = (f: ImageMetadata) => f.width > f.height;

// Retícula del diseño: cada hueco pide una orientación; si no queda ninguna así, la foto conserva su proporción
const slots = [
  { col: '1 / -1', ar: '16 / 9', o: 'L', m: '1 / -1' },
  { col: '1 / span 5', ar: '3 / 4', o: 'P', m: '1 / span 3' },
  { col: '7 / span 6', ar: '4 / 3', o: 'L', m: '2 / span 3' },
  { col: '5 / span 4', ar: '4 / 5', o: 'P', m: '1 / -1' },
  { col: '1 / span 8', ar: '3 / 2', o: 'L', m: '1 / -1' },
];
const libres = [...resto];
const take = (o: string) => {
  const k = libres.findIndex((f) => (o === 'L') === isL(f));
  return k >= 0 ? { img: libres.splice(k, 1)[0], fits: true } : libres.length ? { img: libres.shift()!, fits: false } : null;
};
let alt = 0;
const galeria = slots.flatMap((s) => {
  const t = take(s.o);
  if (!t) return [];
  if (t.fits) return [{ ...s, img: t.img }];
  // foto que no encaja (vertical en hueco horizontal o al revés): conserva su proporción y alterna de lado
  const col = isL(t.img) ? s.col : alt++ % 2 ? '7 / span 5' : '2 / span 5';
  return [{ ...s, col, ar: `${t.img.width} / ${t.img.height}`, img: t.img }];
});
const sangre = take('L');
const bleed = sangre?.fits ? sangre.img : null;
if (sangre && !sangre.fits) galeria.push({ col: '7 / span 6', ar: `${sangre.img.width} / ${sangre.img.height}`, o: 'P', m: '1 / -1', img: sangre.img });

const vistas = [...galeria.map((g) => g.img), ...(bleed ? [bleed] : [])];
const full = await Promise.all(vistas.map((img) => getImage({ src: img, width: Math.min(2400, img.width), format: 'webp', quality: 82 })));
const plural = filtros.find((f) => f.cat === p.categoria)?.label ?? 'Proyectos';
const resumenEnTexto = p.texto[0] && p.texto[0].startsWith(p.resumen);
const cuerpo = p.texto.map((t, i) => (i === 0 && resumenEnTexto ? t.slice(p.resumen.length).trim() : t)).filter(Boolean);
const nota = cuerpo.length > 2 ? cuerpo[cuerpo.length - 1] : null;
const principal = nota ? cuerpo.slice(0, -1) : cuerpo;
const n = (i: number) => String(i + 1).padStart(2, '0');
---
<Base title={p.titulo} description={p.resumen} ogImage={hero.src} current="proyectos">
  <article>
    <div class="frame p-hero" style={`view-transition-name:p-${p.slug}`}>
      <Image src={hero} alt={p.titulo} widths={[828, 1280, 1920, 2560]} sizes="100vw" loading="eager" fetchpriority="high" format="webp" quality={72} />
    </div>

    <section class="pad grid12 head">
      <div class="title-col">
        <a href="/proyectos/" class="small mut">Proyectos / {plural}</a>
        <h1 class="display" data-hero-title>{p.nombre}</h1>
      </div>
      <div class="ficha" data-reveal="text">
        <dl class="keys">
          <div><dt>Lugar</dt><dd class="serif">{ciudad(p)}</dd></div>
          <div><dt>Año</dt><dd class="serif num">{p.anio ?? '—'}</dd></div>
          <div><dt>Superficie</dt><dd class="serif num">{p.superficie ?? '—'}</dd></div>
        </dl>
        <dl class="rows">
          <div><dt>Proyecto</dt><dd>{p.titulo}</dd></div>
          <div><dt>Tipo</dt><dd>{tipo(p)}</dd></div>
          <div><dt>Ubicación</dt><dd>{p.lugar}</dd></div>
          <div><dt>Equipo</dt><dd>NAN Arquitectos</dd></div>
        </dl>
      </div>
    </section>

    <section class="pad grid12 body">
      <div class="text" data-reveal="text">
        <p class="lead serif">{p.resumen}</p>
        {principal.map((t) => <p>{t}</p>)}
        {nota && <p class="t3-mobile">{nota}</p>}
      </div>
    </section>

    <section class="pad grid12 gallery" aria-label="Galería">
      {galeria.map((g, i) => (
        <figure style={`--col:${g.col};--mcol:${g.m}`}>
          <button class="g-open" data-open={i} aria-label={`Ver foto ${n(i)} a pantalla completa`}>
            <div class="frame" data-reveal="img" style={`aspect-ratio:${g.ar}`}>
              <Image src={g.img} alt={`${p.nombre}, foto ${n(i)}`} widths={[640, 1024, 1600, 2400]} sizes={g.col === '1 / -1' ? '100vw' : '(max-width: 760px) 100vw, 60vw'} format="webp" quality={74} />
            </div>
          </button>
          <figcaption class="small mut num">{n(i)}</figcaption>
        </figure>
      ))}
      {nota && nota.length < 420 && <p class="note serif" data-reveal="text"><span>{nota}</span></p>}
    </section>

    {bleed && (
      <>
        <button class="bleed g-open" data-open={galeria.length} aria-label={`Ver foto ${n(galeria.length)} a pantalla completa`}>
          <div class="frame" data-parallax>
            <Image src={bleed} alt={`${p.nombre}, foto ${n(galeria.length)}`} widths={[828, 1280, 1920, 2560]} sizes="100vw" format="webp" quality={72} />
          </div>
        </button>
        <p class="pad small mut num bleed-cap">{n(galeria.length)}</p>
      </>
    )}

    <section class="pad grid12 next">
      <div class="next-text">
        <span class="small mut">Siguiente proyecto</span>
        <a href={`/proyectos/${next.slug}/`} class="next-name">{next.nombre}</a>
        <span class="small mut">{[tipo(next), ciudad(next), next.anio, next.superficie].filter(Boolean).join(' · ')}</span>
        <div class="next-links">
          <a href={`/proyectos/${next.slug}/`}>Ver proyecto →</a>
          <a href="/proyectos/" class="mut">Todos los proyectos</a>
        </div>
      </div>
      <a href={`/proyectos/${next.slug}/`} class="next-img" tabindex="-1" aria-hidden="true">
        <div class="frame" style="aspect-ratio:3 / 2">
          <Image src={portada(next)} alt="" widths={[640, 1024, 1600]} sizes="(max-width: 760px) 100vw, 50vw" format="webp" quality={70} />
        </div>
      </a>
    </section>
  </article>

  <dialog class="lightbox" data-lightbox aria-label="Galería a pantalla completa">
    <img data-lb-img src={full[0]?.src} alt="" loading="lazy" decoding="async" />
    <p class="lb-count num"><span data-lb-i>01</span> / {n(vistas.length - 1)}</p>
    <button class="lb-btn lb-close" data-lb-close>Cerrar</button>
    <button class="lb-btn lb-prev" data-lb-prev>Ant.</button>
    <button class="lb-btn lb-next" data-lb-next>Sig.</button>
  </dialog>
  <script type="application/json" data-lb-src set:html={JSON.stringify(full.map((f, i) => ({ src: f.src, alt: `${p.nombre}, foto ${n(i)}` })))} />
</Base>

<script>
  import { gsap, reduced, ease } from '../../scripts/motion.ts';

  if (!reduced) {
    gsap.from('[data-hero-title]', { y: 30, opacity: 0, duration: 1.4, ease, delay: 0.2 });
  }

  const items: { src: string; alt: string }[] = JSON.parse(document.querySelector('[data-lb-src]')!.textContent!);
  const dlg = document.querySelector<HTMLDialogElement>('[data-lightbox]')!;
  const img = dlg.querySelector<HTMLImageElement>('[data-lb-img]')!;
  const count = dlg.querySelector('[data-lb-i]')!;
  const pad = (i: number) => String(i + 1).padStart(2, '0');
  let cur = 0;

  function go(i: number, dir = 0) {
    cur = (i + items.length) % items.length;
    const swap = () => {
      img.loading = 'eager';
      img.src = items[cur].src;
      img.alt = items[cur].alt;
      count.textContent = pad(cur);
      if (!reduced) gsap.fromTo(img, { opacity: 0, x: dir * 40 }, { opacity: 1, x: 0, duration: 0.7, ease });
    };
    if (dir && !reduced) gsap.to(img, { opacity: 0, x: -dir * 40, duration: 0.25, onComplete: swap });
    else swap();
    new Image().src = items[(cur + 1) % items.length].src;
  }

  document.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((b) =>
    b.addEventListener('click', () => {
      go(Number(b.dataset.open));
      dlg.showModal();
      (window as any).__lenis?.stop();
      if (!reduced) gsap.fromTo(dlg, { opacity: 0 }, { opacity: 1, duration: 0.5, ease });
    }),
  );
  dlg.addEventListener('close', () => (window as any).__lenis?.start());
  dlg.querySelector('[data-lb-close]')!.addEventListener('click', () => dlg.close());
  dlg.querySelector('[data-lb-prev]')!.addEventListener('click', () => go(cur - 1, -1));
  dlg.querySelector('[data-lb-next]')!.addEventListener('click', () => go(cur + 1, 1));
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  dlg.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') go(cur + 1, 1);
    if (e.key === 'ArrowLeft') go(cur - 1, -1);
  });
  let x0 = 0;
  dlg.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
  dlg.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - x0;
    if (Math.abs(dx) > 50) go(cur + (dx < 0 ? 1 : -1), dx < 0 ? 1 : -1);
  });
</script>

<style>
  .display { font-size: clamp(48px, 7.2vw, 104px); line-height: 1; letter-spacing: -0.02em; }
  .p-hero { height: min(860px, calc(100svh - var(--head-h))); min-height: 420px; }

  .head { padding-top: 72px; row-gap: 40px; align-items: start; }
  .title-col { grid-column: 1 / span 7; display: flex; flex-direction: column; gap: 20px; }
  .ficha { grid-column: 9 / span 4; padding-top: 40px; }
  dl { margin: 0; }
  dd { margin: 0; }
  dt { font-size: 12px; color: var(--mut); }
  .keys { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; padding-bottom: 20px; border-bottom: 1px solid var(--line); }
  .keys dd { font-size: clamp(20px, 1.8vw, 26px); line-height: 1.2; }
  .rows div { display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: 16px; padding: 11px 0; border-bottom: 1px solid var(--line); font-size: 13px; }
  .rows dt { font-size: 13px; }

  .body { padding-top: 120px; font-size: 17px; line-height: 1.6; }
  .text { grid-column: 4 / span 5; display: flex; flex-direction: column; gap: 24px; }
  .lead { font-weight: 300; font-size: clamp(22px, 2vw, 28px); line-height: 1.35; }
  .t3-mobile { display: none; }

  .gallery { padding-top: 160px; row-gap: 120px; align-items: end; }
  .gallery figure { grid-column: var(--col); display: flex; flex-direction: column; gap: 12px; }
  .g-open { display: block; width: 100%; cursor: zoom-in; }
  .note { grid-column: 10 / span 3; margin-bottom: 40px; font-weight: 300; font-size: 22px; line-height: 1.4; }

  .bleed { margin-top: 120px; }
  .bleed .frame { aspect-ratio: 21 / 9; }
  .bleed-cap { padding-top: 12px; }

  .next { margin-top: var(--sec); padding-top: 28px; padding-bottom: 120px; border-top: 1px solid var(--line); row-gap: 28px; align-items: stretch; margin-inline: var(--pad); padding-inline: 0; }
  .next-text { grid-column: 1 / span 5; display: flex; flex-direction: column; gap: 16px; }
  .next-name { font-family: var(--serif); font-weight: 300; font-size: clamp(36px, 4.4vw, 64px); line-height: 1.05; letter-spacing: -0.01em; }
  .next-links { margin-top: auto; display: flex; flex-wrap: wrap; gap: 12px 32px; font-size: 14px; padding-top: 24px; }
  .next-img { grid-column: 7 / span 6; }

  .lightbox {
    width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0;
    background: #151513; color: #ece9e3; overflow: hidden;
  }
  .lightbox::backdrop { background: #151513; }
  .lightbox[open] { display: grid; place-items: center; }
  .lightbox img { max-width: calc(100vw - 12rem); max-height: calc(100dvh - 8rem); width: auto; height: auto; object-fit: contain; }
  .lb-count { position: absolute; left: 2rem; bottom: 1.75rem; font-size: 13px; color: #a3a19b; }
  .lb-btn { position: absolute; padding: 12px; font-size: 14px; color: #a3a19b; transition: color 0.3s; }
  .lb-btn:hover, .lb-btn:focus-visible { color: #ece9e3; outline-color: #ece9e3; }
  .lb-close { top: 1.25rem; right: 1.5rem; }
  .lb-prev { left: 1.5rem; top: 50%; translate: 0 -50%; }
  .lb-next { right: 1.5rem; top: 50%; translate: 0 -50%; }

  @media (max-width: 760px) {
    .p-hero { height: 520px; min-height: 0; }
    .head { padding-top: 40px; }
    .title-col, .ficha, .text { grid-column: 1 / -1; }
    .ficha { padding-top: 0; }
    .body { padding-top: 56px; font-size: 15px; }
    .t3-mobile { display: block; }
    .note { display: none; }
    .gallery { padding-top: 72px; row-gap: 40px; }
    .gallery figure { grid-column: var(--mcol); }
    .bleed { margin-top: 40px; }
    .bleed .frame { aspect-ratio: 4 / 5; }
    .next { margin-top: 104px; padding-bottom: 72px; }
    .next-text, .next-img { grid-column: 1 / -1; }
    .lightbox img { max-width: 100vw; max-height: calc(100dvh - 8rem); }
    .lb-prev, .lb-next { top: auto; bottom: 1rem; translate: none; }
    .lb-prev { left: auto; right: 5rem; }
    .lb-next { right: 1rem; }
  }
</style>
