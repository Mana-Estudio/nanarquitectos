---
import { r } from '../../lib/ruta';
import Base from '../../layouts/Base.astro';
import { Image } from 'astro:assets';
import Gallery from '../../components/Gallery.astro';
import { proyectos, portada, ciudad, filtros, tipo, im } from '../../data/proyectos';

export function getStaticPaths() {
  return proyectos.map((p, i) => ({
    params: { slug: p.slug },
    props: { p, i, prev: proyectos[(i - 1 + proyectos.length) % proyectos.length], next: proyectos[(i + 1) % proyectos.length] },
  }));
}

const { p, i: pos, prev, next } = Astro.props;
const M = p.mostrar;
const total = String(proyectos.length);
const hero = portada(p);
const resto = p.fotos.filter((f) => f !== hero);
const plural = filtros.find((f) => f.cat === p.categoria)?.label ?? 'Proyectos';
// Texto: el primer párrafo es la entradilla; el formato lo elige el cliente en el panel
const parrafos = p.texto.map((t) => t.trim()).filter(Boolean);
const formato = p.diseno?.texto ?? 'editorial';
const n = (i: number) => String(i + 1).padStart(2, '0');
---
<Base title={p.titulo} description={p.resumen || `${p.titulo}: proyecto de NAN Arquitectos en ${p.lugar}${p.anio ? ` (${p.anio})` : ''}.`} ogImage={hero.src} current="proyectos">
  <article>
    <div class="frame p-hero" style={`view-transition-name:p-${p.slug}`}>
      <Image {...im(hero)} alt={p.titulo} widths={[828, 1280, 1920, 2560]} sizes="100vw" loading="eager" fetchpriority="high" format="webp" quality={72} />
    </div>

    <section class="pad grid12 head">
      <div class="title-col">
        <nav class="pager small num" aria-label="Navegar entre proyectos">
          <a href={r('/proyectos/')} class="mut ulink">Proyectos / {plural}</a>
          <span class="pager-nav">
            <a href={r(`/proyectos/${prev.slug}/`)} class="pg-btn" aria-label={`Proyecto anterior: ${prev.nombre}`} data-pg="prev"><span class="arr-l">←</span></a>
            <span class="mut">{String(pos + 1).padStart(2, '0')} / {total}</span>
            <a href={r(`/proyectos/${next.slug}/`)} class="pg-btn" aria-label={`Proyecto siguiente: ${next.nombre}`} data-pg="next"><span class="arr">→</span></a>
          </span>
        </nav>
        <h1 class="display" data-hero-title>{p.nombre}</h1>
      </div>
      {M.ficha && <div class="ficha" data-reveal="text">
        <dl class="keys">
          <div><dt>Lugar</dt><dd class="serif">{ciudad(p)}</dd></div>
          <div><dt>Año</dt><dd class="serif num">{p.anio ?? '—'}</dd></div>
          <div><dt>Superficie</dt><dd class="serif num">{p.superficie ?? '—'}</dd></div>
        </dl>
        <dl class="rows">
          <div><dt>Proyecto</dt><dd>{p.titulo}</dd></div>
          <div><dt>Tipo</dt><dd>{tipo(p)}</dd></div>
          <div><dt>Ubicación</dt><dd>{p.lugar}</dd></div>
          <div><dt>Equipo</dt><dd>NAN Arquitectos</dd></div>
        </dl>
      </div>}
    </section>

    {M.texto && parrafos.length > 0 && <section class:list={['pad grid12 body', `f-${formato}`]}>
      <div class="text" data-reveal="text">
        <p class="lead serif">{parrafos[0]}</p>
        {parrafos.length > 1 && <div class="rest">{parrafos.slice(1).map((t) => <p>{t}</p>)}</div>}
      </div>
    </section>}

    {M.galeria && resto.length > 0 && (
      <div class:list={['gallery', `is-${p.galeria}`]}>
        <Gallery fotos={resto} layout={p.galeria} titulo={p.titulo} />
      </div>
    )}

    {M.planos && p.planos.length > 0 && (
      <div class="planos">
        <h2 class="pad small mut planos-t">Planos</h2>
        <Gallery fotos={p.planos} layout="mosaico" titulo={`${p.titulo}, plano`} label="Planos" contain />
      </div>
    )}

    {M.siguiente && <section class="pad grid12 next">
      <div class="next-text">
        <span class="small mut">Siguiente proyecto</span>
        <a href={r(`/proyectos/${next.slug}/`)} class="next-name">{next.nombre}</a>
        <span class="small mut">{[tipo(next), ciudad(next), next.anio, next.superficie].filter(Boolean).join(' · ')}</span>
        <div class="next-links">
          <a href={r(`/proyectos/${next.slug}/`)} class="btn">Ver proyecto <span class="arr">→</span></a>
          <a href={r(`/proyectos/${prev.slug}/`)} class="btn-ghost"><span class="arr-l">←</span> Anterior</a>
          <a href={r('/proyectos/')} class="mut ulink">Todos los proyectos</a>
        </div>
      </div>
      <a href={r(`/proyectos/${next.slug}/`)} class="next-img" tabindex="-1" aria-hidden="true">
        <div class="frame" style="aspect-ratio:3 / 2">
          <Image {...im(portada(next))} alt="" widths={[640, 1024, 1600]} sizes="(max-width: 760px) 100vw, 50vw" format="webp" quality={70} />
        </div>
      </a>
    </section>}
  </article>

  <dialog class="lightbox" data-lightbox aria-label="Galería a pantalla completa">
    <img data-lb-img alt="" decoding="async" />
    <p class="lb-count num" aria-live="polite"><span class="sr-only">Imagen </span><span data-lb-i>01</span> / <span data-lb-n></span></p>
    <button class="lb-btn lb-close" data-lb-close aria-label="Cerrar galería">Cerrar</button>
    <button class="lb-btn lb-prev" data-lb-prev aria-label="Ant., imagen anterior">Ant.</button>
    <button class="lb-btn lb-next" data-lb-next aria-label="Sig., imagen siguiente">Sig.</button>
  </dialog>
</Base>

<script>
  import { gsap, reduced, ease } from '../../scripts/motion.ts';

  if (!reduced) {
    gsap.from('[data-hero-title]', { y: 30, opacity: 0, duration: 1.4, ease, delay: 0.2 });
  }

  // Las fotos (galería y planos) se leen del DOM: cada [data-open] trae su versión grande
  const opens = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-open]'));
  const items = opens.map((b) => ({ src: b.dataset.full!, alt: b.querySelector('img')?.alt ?? '' }));
  document.querySelector('[data-lb-n]')!.textContent = String(items.length).padStart(2, '0');
  // Flechas del teclado fuera del visor: proyecto anterior / siguiente
  document.addEventListener('keydown', (e) => {
    if (document.querySelector('dialog[open]') || (e.target as HTMLElement).closest('input, textarea, [data-strip-track]')) return;
    const a = document.querySelector<HTMLAnchorElement>(`[data-pg="${e.key === 'ArrowRight' ? 'next' : e.key === 'ArrowLeft' ? 'prev' : ''}"]`);
    if (a) a.click();
  });
  const dlg = document.querySelector<HTMLDialogElement>('[data-lightbox]')!;
  const img = dlg.querySelector<HTMLImageElement>('[data-lb-img]')!;
  const count = dlg.querySelector('[data-lb-i]')!;
  const pad = (i: number) => String(i + 1).padStart(2, '0');
  let cur = 0;

  function go(i: number, dir = 0) {
    cur = (i + items.length) % items.length;
    const swap = () => {
      img.loading = 'eager';
      const at = cur;
      // Muestra al instante la miniatura ya cargada y la cambia por la versión grande cuando llega
      const thumb = opens[at]?.querySelector('img')?.currentSrc;
      const full = new Image();
      full.onload = () => { if (cur === at) img.src = items[at].src; };
      full.src = items[at].src;
      if (!full.complete && thumb) img.src = thumb;
      else img.src = items[at].src;
      img.alt = items[cur].alt;
      count.textContent = pad(cur);
      if (!reduced) gsap.fromTo(img, { opacity: 0, x: dir * 40 }, { opacity: 1, x: 0, duration: 0.7, ease });
      else gsap.fromTo(img, { opacity: 0 }, { opacity: 1, duration: 0.2 });
    };
    if (dir && !reduced) gsap.to(img, { opacity: 0, x: -dir * 40, duration: 0.25, onComplete: swap });
    else swap();
    new Image().src = items[(cur + 1) % items.length].src;
  }

  if (!items.length) document.querySelector('[data-lb-n]')!.textContent = '00';
  opens.forEach((b, k) =>
    b.addEventListener('click', () => {
      go(k);
      dlg.showModal();
      (window as any).__lenis?.stop();
      if (!reduced) gsap.fromTo(dlg, { opacity: 0 }, { opacity: 1, duration: 0.5, ease });
    }),
  );
  dlg.addEventListener('close', () => (window as any).__lenis?.start());
  dlg.querySelector('[data-lb-close]')!.addEventListener('click', () => dlg.close());
  dlg.querySelector('[data-lb-prev]')!.addEventListener('click', () => go(cur - 1, -1));
  dlg.querySelector('[data-lb-next]')!.addEventListener('click', () => go(cur + 1, 1));
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  dlg.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') go(cur + 1, 1);
    if (e.key === 'ArrowLeft') go(cur - 1, -1);
  });
  let x0 = 0;
  dlg.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
  dlg.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - x0;
    if (Math.abs(dx) > 50) go(cur + (dx < 0 ? 1 : -1), dx < 0 ? 1 : -1);
  });
</script>

<style>
  .display { font-size: clamp(48px, 7.2vw, 104px); line-height: 1; letter-spacing: -0.02em; }
  .p-hero { height: min(860px, calc(100svh - var(--head-h))); min-height: 420px; }

  .head { padding-top: 72px; row-gap: 40px; align-items: start; }
  .title-col { grid-column: 1 / span 7; display: flex; flex-direction: column; gap: 20px; }
  .ficha { grid-column: 9 / span 4; padding-top: 40px; }
  dl { margin: 0; }
  dd { margin: 0; }
  dt { font-size: 12px; color: var(--mut); }
  .keys { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; padding-bottom: 20px; border-bottom: 1px solid var(--line); }
  .keys dd { font-size: clamp(20px, 1.8vw, 26px); line-height: 1.2; }
  .rows div { display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: 16px; padding: 11px 0; border-bottom: 1px solid var(--line); font-size: 13px; }
  .rows dt { font-size: 13px; }

  .body { padding-top: 120px; font-size: 17px; line-height: 1.6; }
  /* Formatos de texto (los mismos que ofrece el panel) */
  .text { grid-column: 4 / span 5; display: flex; flex-direction: column; gap: 24px; }
  .rest { display: flex; flex-direction: column; gap: 24px; }
  .lead { font-weight: 300; font-size: clamp(22px, 2vw, 28px); line-height: 1.35; }
  .f-columnas .text { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--gap) calc(var(--gap) * 3); align-items: start; }
  .f-columnas .lead { font-size: clamp(26px, 2.6vw, 38px); line-height: 1.2; }
  .f-columnas .rest { display: block; columns: 2; column-gap: calc(var(--gap) * 2); }
  .f-columnas .rest p { break-inside: avoid; margin-bottom: 24px; }
  .f-cita .text { grid-column: 2 / span 10; gap: 56px; }
  .f-cita .lead { font-size: clamp(30px, 4vw, 58px); line-height: 1.1; letter-spacing: -0.015em; text-wrap: balance; }
  .f-cita .rest { margin-left: 50%; }

  .gallery { padding-top: 120px; }
  .gallery.is-sueltas { padding-top: 160px; }
  .note { max-width: calc(38ch + var(--pad) * 2); margin: 64px 0 0 auto; font-weight: 300; font-size: 22px; line-height: 1.4; }
  .planos { padding-top: 120px; }
  .planos-t { font-family: var(--sans); font-weight: 400; font-size: 13px; padding-bottom: 16px; }

  .pager { display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .pager-nav { display: flex; align-items: center; gap: 10px; }
  .pg-btn { width: 40px; height: 40px; display: grid; place-items: center; box-shadow: inset 0 0 0 1px var(--line); transition: background-color 0.35s, color 0.35s; }
  .pg-btn:hover { background: var(--ink); color: var(--bg); }

  .next { margin-top: var(--sec); padding-top: 28px; padding-bottom: 120px; border-top: 1px solid var(--line); row-gap: 28px; align-items: stretch; margin-inline: var(--pad); padding-inline: 0; }
  .next-text { grid-column: 1 / span 5; display: flex; flex-direction: column; gap: 16px; }
  .next-name { font-family: var(--serif); font-weight: 300; font-size: clamp(36px, 4.4vw, 64px); line-height: 1.05; letter-spacing: -0.01em; }
  .next-links { margin-top: auto; display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; font-size: 14px; padding-top: 24px; }
  .next-img { grid-column: 7 / span 6; }

  .lightbox {
    width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0;
    background: var(--night); color: var(--night-ink); overflow: hidden;
  }
  .lightbox::backdrop { background: var(--night); }
  .lightbox[open] { display: grid; place-items: center; }
  .lightbox img { max-width: calc(100vw - 12rem); max-height: calc(100dvh - 8rem); width: auto; height: auto; object-fit: contain; }
  .lb-count { position: absolute; left: 2rem; bottom: 1.75rem; font-size: 13px; color: var(--night-mut); }
  .lb-btn { position: absolute; padding: 12px; font-size: 14px; color: var(--night-mut); transition: color 0.3s; }
  .lb-btn:hover, .lb-btn:focus-visible { color: var(--night-ink); outline-color: var(--night-ink); }
  .lb-close { top: 1.25rem; right: 1.5rem; }
  .lb-prev { left: 1.5rem; top: 50%; translate: 0 -50%; }
  .lb-next { right: 1.5rem; top: 50%; translate: 0 -50%; }

  @media (max-width: 760px) {
    .p-hero { height: 520px; min-height: 0; }
    .head { padding-top: 40px; }
    .title-col, .ficha, .text, .f-columnas .text, .f-cita .text { grid-column: 1 / -1; }
    .f-columnas .text { grid-template-columns: 1fr; }
    .f-columnas .rest { columns: 1; }
    .f-cita .text { gap: 32px; }
    .f-cita .rest { margin-left: 0; }
    .ficha { padding-top: 0; }
    .body { padding-top: 56px; font-size: 15px; }
    .note { display: none; }
    .gallery, .gallery.is-sueltas, .planos { padding-top: 56px; }
    .next { margin-top: 104px; padding-bottom: 72px; }
    .next-text, .next-img { grid-column: 1 / -1; }
    .lightbox img { max-width: 100vw; max-height: calc(100dvh - 8rem); }
    .lb-prev, .lb-next { top: auto; bottom: 1rem; translate: none; }
    .lb-prev { left: auto; right: 5rem; }
    .lb-next { right: 1rem; }
  }
</style>
