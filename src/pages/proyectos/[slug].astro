---
import Base from '../../layouts/Base.astro';
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { proyectos, portada } from '../../data/proyectos';

export function getStaticPaths() {
  return proyectos.map((p, i) => ({
    params: { slug: p.slug },
    props: { p, next: proyectos[(i + 1) % proyectos.length] },
  }));
}

const { p, next } = Astro.props;
const hero = portada(p);
const galeria = p.fotos.filter((f) => f !== hero);

// Ritmo: horizontales a todo el ancho, verticales de a pares
type Row = { kind: 'wide' | 'pair' | 'single'; items: { img: ImageMetadata; i: number }[] };
const rows: Row[] = [];
let pending: { img: ImageMetadata; i: number } | null = null;
galeria.forEach((img, i) => {
  if (img.width > img.height) rows.push({ kind: 'wide', items: [{ img, i }] });
  else if (pending) { rows.push({ kind: 'pair', items: [pending, { img, i }] }); pending = null; }
  else pending = { img, i };
});
if (pending) rows.push({ kind: 'single', items: [pending] });

const full = await Promise.all(galeria.map((img) => getImage({ src: img, width: Math.min(2400, img.width), format: 'webp', quality: 82 })));
const nextImg = portada(next);
---
<Base title={p.titulo} description={p.resumen} overlay ogImage={hero.src}>
  <article>
    <header class="p-hero">
      <div class="frame p-hero-img" style={`view-transition-name: p-${p.slug}`}>
        <Image src={hero} alt={p.titulo} widths={[828, 1280, 1920, 2560]} sizes="100vw" loading="eager" fetchpriority="high" format="avif" quality={72} />
      </div>
      <div class="p-hero-copy wrap">
        <h1 data-hero-title><span class="line"><span>{p.nombre}</span></span></h1>
        <p class="p-cat">{p.categoria} · {p.lugar.split(',').pop()?.trim()} · {p.anio}</p>
      </div>
    </header>

    <section class="p-intro wrap">
      <dl class="ficha" data-reveal="text">
        <div><dt class="label">Proyecto</dt><dd>{p.titulo}</dd></div>
        <div><dt class="label">Lugar</dt><dd>{p.lugar}</dd></div>
        <div><dt class="label">Año</dt><dd class="num">{p.anio}</dd></div>
        <div><dt class="label">Superficie</dt><dd class="num">{p.superficie}</dd></div>
      </dl>
      <div class="p-text">
        <p class="p-lead" data-reveal="text"><span>{p.resumen}</span></p>
        <div class="p-body" data-reveal="text">
          {p.texto.map((t) => <p>{t}</p>)}
        </div>
      </div>
    </section>

    <section class="gallery wrap" aria-label="Galería">
      {rows.map((row) => (
        <div class:list={['g-row', `g-${row.kind}`]}>
          {row.items.map(({ img, i }) => (
            <button class="g-item" data-open={i} aria-label={`Ver foto ${i + 1} de ${galeria.length} a pantalla completa`}>
              <div class="frame" data-reveal="img" style={`aspect-ratio: ${img.width} / ${img.height}`}>
                <Image src={img} alt={`${p.nombre}, foto ${i + 1}`} widths={[640, 1024, 1600, 2400]} sizes={row.kind === 'wide' ? '100vw' : '(max-width: 760px) 100vw, 50vw'} format="avif" quality={74} />
              </div>
            </button>
          ))}
        </div>
      ))}
    </section>

    <a class="next" href={`/proyectos/${next.slug}/`}>
      <div class="frame next-img" data-parallax>
        <Image src={nextImg} alt="" widths={[828, 1280, 1920]} sizes="100vw" format="avif" quality={65} />
      </div>
      <div class="next-copy wrap">
        <span class="next-label">Siguiente proyecto</span>
        <span class="next-name">{next.nombre}</span>
      </div>
    </a>
  </article>

  <dialog class="lightbox" data-lightbox aria-label="Galería a pantalla completa">
    <img data-lb-img src={full[0]?.src} alt="" loading="lazy" decoding="async" />
    <p class="lb-count"><span data-lb-i>1</span> / {galeria.length}</p>
    <button class="lb-btn lb-close" data-lb-close aria-label="Cerrar">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="1.4" fill="none" /></svg>
    </button>
    <button class="lb-btn lb-prev" data-lb-prev aria-label="Foto anterior">
      <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path d="M15 4l-8 8 8 8" stroke="currentColor" stroke-width="1.4" fill="none" /></svg>
    </button>
    <button class="lb-btn lb-next" data-lb-next aria-label="Foto siguiente">
      <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path d="M9 4l8 8-8 8" stroke="currentColor" stroke-width="1.4" fill="none" /></svg>
    </button>
  </dialog>
  <script type="application/json" data-lb-src set:html={JSON.stringify(full.map((f, i) => ({ src: f.src, alt: `${p.nombre}, foto ${i + 1}` })))} />
</Base>

<script>
  import { gsap, reduced, ease } from '../../scripts/motion.ts';

  if (!reduced) {
    gsap.from('[data-hero-title] .line > span', { yPercent: 110, duration: 1.4, ease, delay: 0.25 });
    gsap.from('.p-cat', { opacity: 0, y: 12, duration: 1.2, ease, delay: 0.45 });
  }

  const items: { src: string; alt: string }[] = JSON.parse(document.querySelector('[data-lb-src]')!.textContent!);
  const dlg = document.querySelector<HTMLDialogElement>('[data-lightbox]')!;
  const img = dlg.querySelector<HTMLImageElement>('[data-lb-img]')!;
  const count = dlg.querySelector('[data-lb-i]')!;
  let cur = 0;

  function go(i: number, dir = 0) {
    cur = (i + items.length) % items.length;
    const swap = () => {
      img.src = items[cur].src;
      img.alt = items[cur].alt;
      count.textContent = String(cur + 1);
      if (!reduced) gsap.fromTo(img, { opacity: 0, x: dir * 40 }, { opacity: 1, x: 0, duration: 0.7, ease });
    };
    if (dir && !reduced) gsap.to(img, { opacity: 0, x: -dir * 40, duration: 0.25, onComplete: swap });
    else swap();
    // precarga la siguiente
    new Image().src = items[(cur + 1) % items.length].src;
  }

  document.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((b) =>
    b.addEventListener('click', () => {
      go(Number(b.dataset.open));
      dlg.showModal();
      (window as any).__lenis?.stop();
      if (!reduced) gsap.fromTo(dlg, { opacity: 0 }, { opacity: 1, duration: 0.5, ease });
    }),
  );
  dlg.addEventListener('close', () => (window as any).__lenis?.start());
  dlg.querySelector('[data-lb-close]')!.addEventListener('click', () => dlg.close());
  dlg.querySelector('[data-lb-prev]')!.addEventListener('click', () => go(cur - 1, -1));
  dlg.querySelector('[data-lb-next]')!.addEventListener('click', () => go(cur + 1, 1));
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  dlg.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') go(cur + 1, 1);
    if (e.key === 'ArrowLeft') go(cur - 1, -1);
  });
  let x0 = 0;
  dlg.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
  dlg.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - x0;
    if (Math.abs(dx) > 50) go(cur + (dx < 0 ? 1 : -1), dx < 0 ? 1 : -1);
  });
</script>

<style>
  .p-hero { position: relative; height: 100svh; min-height: 520px; color: #fff; background: var(--ink); }
  .p-hero-img { position: absolute; inset: 0; background: var(--ink); }
  .p-hero::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(to bottom, rgb(0 0 0 / 0.35), transparent 25%), linear-gradient(to top, rgb(0 0 0 / 0.5), transparent 45%);
  }
  .p-hero-copy { position: absolute; left: 0; right: 0; bottom: clamp(2.5rem, 7vh, 5rem); z-index: 1; }
  .p-cat { font-size: 0.875rem; color: rgb(255 255 255 / 0.85); margin-top: 1rem; }
  .p-hero h1 { font-size: clamp(3rem, 10vw, 6rem); letter-spacing: -0.035em; font-weight: 340; }
  .line { display: block; overflow: hidden; padding-bottom: 0.08em; }
  .line > span { display: inline-block; }

  .p-intro {
    display: grid; grid-template-columns: repeat(12, 1fr); gap: clamp(1rem, 2vw, 2rem);
    padding-block: clamp(4rem, 10vw, 9rem);
  }
  .ficha { grid-column: 1 / 5; margin: 0; display: grid; gap: 1.25rem; align-content: start; }
  .ficha div { display: grid; gap: 0.2rem; padding-bottom: 1.25rem; border-bottom: 1px solid var(--line); }
  .ficha dd { margin: 0; font-size: 0.9375rem; }
  .num { font-variant-numeric: tabular-nums; }
  .p-text { grid-column: 6 / 12; }
  .p-lead { font-family: var(--serif); font-size: clamp(1.6rem, 3vw, 2.5rem); line-height: 1.2; font-weight: 360; letter-spacing: -0.015em; margin-bottom: 2.5rem; max-width: 26ch; }
  .p-body { display: grid; gap: 1.25rem; color: var(--ink-2); max-width: 62ch; }

  .gallery { display: grid; gap: clamp(1rem, 2vw, 2rem); padding-bottom: clamp(5rem, 12vw, 10rem); }
  .g-row { display: grid; gap: clamp(1rem, 2vw, 2rem); }
  .g-pair { grid-template-columns: 1fr 1fr; align-items: start; }
  .g-pair .g-item:nth-child(2) { margin-top: clamp(0rem, 8vw, 8rem); }
  .g-single { grid-template-columns: repeat(12, 1fr); }
  .g-single .g-item { grid-column: 4 / 10; }
  .g-wide { margin-inline: calc(var(--gutter) * -0.5); }
  .g-item { display: block; padding: 0; border: 0; background: none; cursor: zoom-in; width: 100%; }
  .g-item .frame :global(img) { transition: transform 1.2s var(--ease-out); }
  .g-item:hover .frame :global(img) { transform: scale(1.02); }

  .next { position: relative; display: block; height: 80svh; min-height: 420px; color: #fff; overflow: hidden; }
  .next-img { position: absolute; inset: 0; }
  .next::after { content: ''; position: absolute; inset: 0; background: rgb(0 0 0 / 0.4); transition: background-color 0.8s var(--ease-out); }
  .next:hover::after { background: rgb(0 0 0 / 0.25); }
  .next-copy { position: absolute; inset: 0; z-index: 1; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; gap: 1rem; }
  .next-label { font-size: 0.875rem; color: rgb(255 255 255 / 0.85); }
  .next-name { font-family: var(--serif); font-size: clamp(2.75rem, 8vw, 6rem); line-height: 1; letter-spacing: -0.03em; font-weight: 340; }

  .lightbox {
    width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0;
    background: #0f0e0c; color: #fff; overflow: hidden;
  }
  .lightbox::backdrop { background: #0f0e0c; }
  .lightbox[open] { display: grid; place-items: center; }
  .lightbox img { max-width: calc(100vw - 10rem); max-height: calc(100dvh - 7rem); width: auto; height: auto; object-fit: contain; }
  .lb-count { position: absolute; left: 2rem; bottom: 1.75rem; font-size: 0.875rem; font-variant-numeric: tabular-nums; color: rgb(255 255 255 / 0.7); }
  .lb-btn { position: absolute; display: grid; place-items: center; width: 48px; height: 48px; background: none; border: 0; color: #fff; cursor: pointer; opacity: 0.75; transition: opacity 0.3s; }
  .lb-btn:hover, .lb-btn:focus-visible { opacity: 1; }
  .lb-btn:focus-visible { outline-color: #fff; }
  .lb-close { top: 1.25rem; right: 1.25rem; }
  .lb-prev { left: 1.5rem; top: 50%; translate: 0 -50%; }
  .lb-next { right: 1.5rem; top: 50%; translate: 0 -50%; }

  @media (max-width: 760px) {
    .ficha, .p-text { grid-column: 1 / -1; }
    .ficha { grid-template-columns: 1fr 1fr; margin-bottom: 2.5rem; }
    .ficha div:first-child { grid-column: 1 / -1; }
    .g-pair { grid-template-columns: 1fr; }
    .g-pair .g-item:nth-child(2) { margin-top: 0; }
    .g-single .g-item { grid-column: 1 / -1; }
    .g-wide { margin-inline: 0; }
    .lightbox img { max-width: 100vw; max-height: calc(100dvh - 8rem); }
    .lb-prev, .lb-next { top: auto; bottom: 0.75rem; translate: none; }
    .lb-prev { left: auto; right: 4.5rem; }
    .lb-next { right: 1rem; }
  }
</style>
