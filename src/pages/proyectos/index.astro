---
import Base from '../../layouts/Base.astro';
import { Image, getImage } from 'astro:assets';
import { proyectos, categorias, portada } from '../../data/proyectos';

const counts = Object.fromEntries(categorias.map((c) => [c, proyectos.filter((p) => p.categoria === c).length]));
const previews = await Promise.all(
  proyectos.map((p) => getImage({ src: portada(p), width: 640, format: 'avif', quality: 70 })),
);
---
<Base title="Proyectos" description="Proyectos de arquitectura e interiorismo de NAN Arquitectos: clínicas, hostelería, comercio, oficinas y vivienda en Pontevedra.">
  <section class="head wrap">
    <h1 data-reveal="text"><span>Proyectos</span></h1>
    <div class="controls" data-reveal="text">
      <div class="filters" role="group" aria-label="Filtrar por tipo">
        <button class="filter is-active" data-filter="all" aria-pressed="true">Todos <sup>{proyectos.length}</sup></button>
        {categorias.filter((c) => counts[c]).map((c) => (
          <button class="filter" data-filter={c} aria-pressed="false">{c} <sup>{counts[c]}</sup></button>
        ))}
      </div>
      <div class="views" role="group" aria-label="Vista">
        <button class="view is-active" data-view="grid" aria-pressed="true">Galería</button>
        <button class="view" data-view="index" aria-pressed="false">Índice</button>
      </div>
    </div>
  </section>

  <section class="wrap" aria-label="Listado de proyectos">
    <ul class="grid" data-grid>
      {proyectos.map((p, i) => (
        <li class="card" data-cat={p.categoria}>
          <a href={`/proyectos/${p.slug}/`}>
            <div class="frame" data-reveal="img" style={`view-transition-name: p-${p.slug}`}>
              <Image src={portada(p)} alt={p.titulo} widths={[640, 1024, 1600]} sizes="(max-width: 760px) 100vw, (max-width: 1100px) 50vw, 33vw" format="avif" quality={72} loading={i < 3 ? 'eager' : 'lazy'} />
            </div>
            <h2>{p.nombre}</h2>
            <p class="label">{p.categoria} · {p.anio}</p>
          </a>
        </li>
      ))}
    </ul>

    <ol class="index" data-index hidden>
      <li class="index-row index-head label" aria-hidden="true">
        <span>Proyecto</span><span>Tipo</span><span>Lugar</span><span>Año</span>
      </li>
      {proyectos.map((p, i) => (
        <li class="index-row" data-cat={p.categoria}>
          <a href={`/proyectos/${p.slug}/`} data-preview={previews[i].src}>
            <span class="index-name">{p.nombre}</span>
            <span>{p.categoria}</span>
            <span>{p.lugar.split(',').pop()?.trim()}</span>
            <span class="num">{p.anio}</span>
          </a>
        </li>
      ))}
    </ol>
    <div class="preview" data-preview-box aria-hidden="true"><img src={previews[0].src} alt="" loading="lazy" /></div>
  </section>
</Base>

<script>
  import { gsap, reduced, ease } from '../../scripts/motion.ts';
  import { Flip } from 'gsap/Flip';
  gsap.registerPlugin(Flip);

  const grid = document.querySelector<HTMLElement>('[data-grid]')!;
  const index = document.querySelector<HTMLElement>('[data-index]')!;
  const cards = Array.from(grid.querySelectorAll<HTMLElement>('.card'));
  const rows = Array.from(index.querySelectorAll<HTMLElement>('.index-row[data-cat]'));

  function press(group: string, btn: HTMLElement) {
    document.querySelectorAll<HTMLElement>(group).forEach((b) => {
      b.classList.toggle('is-active', b === btn);
      b.setAttribute('aria-pressed', String(b === btn));
    });
  }

  document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((btn) =>
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter!;
      press('[data-filter]', btn);
      const state = Flip.getState(cards);
      cards.forEach((c) => c.classList.toggle('is-hidden', f !== 'all' && c.dataset.cat !== f));
      rows.forEach((r) => r.classList.toggle('is-hidden', f !== 'all' && r.dataset.cat !== f));
      if (!reduced) {
        Flip.from(state, {
          duration: 0.9, ease, absolute: true, scale: true,
          onEnter: (els) => gsap.fromTo(els, { opacity: 0, scale: 0.94 }, { opacity: 1, scale: 1, duration: 0.8, ease }),
          onLeave: (els) => gsap.to(els, { opacity: 0, scale: 0.94, duration: 0.4 }),
        });
      }
    }),
  );

  document.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((btn) =>
    btn.addEventListener('click', () => {
      press('[data-view]', btn);
      const isIndex = btn.dataset.view === 'index';
      grid.hidden = isIndex;
      index.hidden = !isIndex;
      if (!reduced) gsap.from(isIndex ? rows : cards, { opacity: 0, y: 20, duration: 0.9, stagger: 0.05, ease });
    }),
  );

  /* Índice: la foto del proyecto sigue al cursor */
  const box = document.querySelector<HTMLElement>('[data-preview-box]')!;
  const img = box.querySelector('img')!;
  if (window.matchMedia('(hover: hover)').matches) {
    const xTo = gsap.quickTo(box, 'x', { duration: 0.6, ease: 'power3' });
    const yTo = gsap.quickTo(box, 'y', { duration: 0.6, ease: 'power3' });
    index.addEventListener('mousemove', (e) => { xTo(e.clientX + 24); yTo(e.clientY - 120); });
    index.querySelectorAll<HTMLAnchorElement>('a[data-preview]').forEach((a) => {
      a.addEventListener('mouseenter', () => { img.src = a.dataset.preview!; box.classList.add('is-on'); });
      a.addEventListener('mouseleave', () => box.classList.remove('is-on'));
    });
  }
</script>

<style>
  .head { padding-top: calc(var(--header-h) + clamp(3rem, 8vw, 7rem)); padding-bottom: clamp(2rem, 4vw, 3.5rem); }
  h1 { font-size: clamp(3.5rem, 11vw, 6rem); letter-spacing: -0.035em; }
  .controls { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1.5rem; margin-top: clamp(2rem, 5vw, 4rem); padding-top: 1.25rem; border-top: 1px solid var(--line); }
  .filters, .views { display: flex; flex-wrap: wrap; gap: 0.5rem 1.75rem; }
  .filter, .view {
    background: none; border: 0; padding: 0.25rem 0; cursor: pointer;
    font-size: 0.9375rem; color: var(--stone);
    transition: color 0.4s var(--ease-out);
  }
  .filter sup { font-size: 0.65em; margin-left: 0.15em; font-variant-numeric: tabular-nums; }
  .filter:hover, .view:hover, .is-active { color: var(--ink); }
  .filter.is-active, .view.is-active { box-shadow: 0 1px 0 currentColor; }

  .grid {
    list-style: none; margin: 0; padding: 0 0 clamp(6rem, 12vw, 10rem);
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: clamp(3rem, 6vw, 5rem) clamp(1rem, 2vw, 2rem);
  }
  .card.is-hidden, .index-row.is-hidden { display: none; }
  .card:nth-child(3n + 2) { margin-top: clamp(0rem, 6vw, 6rem); }
  .card .frame { aspect-ratio: 4 / 5; }
  .card .frame :global(img) { transition: transform 1.2s var(--ease-out); }
  .card a:hover .frame :global(img) { transform: scale(1.035); }
  .card h2 { font-size: clamp(1.4rem, 2vw, 1.75rem); margin: 1rem 0 0.35rem; }

  .index { list-style: none; margin: 0; padding: 0 0 clamp(6rem, 12vw, 10rem); }
  .index-row a, .index-head { display: grid; grid-template-columns: 2.2fr 1fr 1fr 0.4fr; gap: 1rem; align-items: baseline; }
  .index-head { padding-bottom: 0.75rem; }
  .index-row a { padding-block: 1.25rem; border-top: 1px solid var(--line); color: var(--ink-2); transition: color 0.4s var(--ease-out), padding 0.6s var(--ease-out); }
  .index-row:last-child a { border-bottom: 1px solid var(--line); }
  .index-name { font-family: var(--serif); font-size: clamp(1.5rem, 3vw, 2.5rem); color: var(--ink); line-height: 1.1; }
  .num { font-variant-numeric: tabular-nums; text-align: right; }
  .index:hover .index-row a { color: var(--stone); }
  .index:hover .index-row a:hover { color: var(--ink); padding-left: 1rem; }

  .preview {
    position: fixed; left: 0; top: 0; z-index: 40; pointer-events: none;
    width: 18rem; aspect-ratio: 4 / 5; overflow: hidden;
    clip-path: inset(50% 50% 50% 50%); transition: clip-path 0.6s var(--ease-out);
  }
  .preview.is-on { clip-path: inset(0 0 0 0); }
  .preview img { width: 100%; height: 100%; object-fit: cover; }

  @media (max-width: 1100px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
    .card:nth-child(3n + 2) { margin-top: 0; }
    .card:nth-child(2n) { margin-top: clamp(0rem, 8vw, 5rem); }
  }
  @media (max-width: 760px) {
    .grid { grid-template-columns: 1fr; }
    .card:nth-child(2n) { margin-top: 0; }
    .index-row a, .index-head { grid-template-columns: 1fr auto; }
    .index-row a span:nth-child(2), .index-row a span:nth-child(3), .index-head span:nth-child(2), .index-head span:nth-child(3) { display: none; }
  }
</style>
