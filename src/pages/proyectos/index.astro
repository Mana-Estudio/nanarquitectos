---
import { r } from '../../lib/ruta';
import Base from '../../layouts/Base.astro';
import { Image, getImage } from 'astro:assets';
import { proyectos, filtros, portada, ciudad, tipo, im } from '../../data/proyectos';

const conteo = (cat: string | null) => (cat ? proyectos.filter((p) => p.categoria === cat).length : proyectos.length);
const fmt = new Intl.NumberFormat('es-ES');
const meta = (p: (typeof proyectos)[number]) => [tipo(p), ciudad(p), p.anio].filter(Boolean).join(' · ');
// Mosaico: patrón de 9 piezas que encaja en 5 filas; 18 proyectos por página
const PER = 18;
const SHAPES = 'abcdefghi';
const pages = Math.ceil(proyectos.length / PER);
const previews = await Promise.all(proyectos.map((p) => getImage({ ...im(portada(p), 640), format: 'webp', quality: 72 })));
---
<Base title="Proyectos" current="proyectos" description="Proyectos de NAN Arquitectos: clínicas, hostelería, comercios, oficinas y viviendas en Pontevedra y Galicia.">
  <section class="intro pad grid12">
    <h1 class="title">Proyectos<sup class="num" data-total>{proyectos.length}</sup></h1>
    <p class="intro-text">Clínicas, restaurantes, comercios, oficinas y viviendas en Galicia y Madrid, desde 2013.</p>
  </section>

  <div class="bar" role="toolbar" aria-label="Filtros y vista">
    <div class="filters" role="group" aria-label="Filtrar por tipo">
      {filtros.filter((f) => conteo(f.cat)).map((f, i) => (
        <button class:list={['chip', { 'is-on': i === 0 }]} data-filter={f.cat ?? 'all'} aria-pressed={i === 0 ? 'true' : 'false'}>
          <span>{f.label}</span><span class="count num">{conteo(f.cat)}</span>
        </button>
      ))}
    </div>
    <div class="views" role="group" aria-label="Vista">
      <button class="chip-view is-on" data-view="grid" aria-pressed="true">Retícula</button>
      <button class="chip-view" data-view="index" aria-pressed="false">Índice</button>
    </div>
  </div>

  <p class="sr-only" role="status" data-status></p>
  <section class="list pad" aria-label="Listado de proyectos">
    <ul class="grid grid12" data-grid data-per={PER}>
      {proyectos.map((p, i) => (
        <li class="card" data-cat={p.categoria} data-shape={SHAPES[i % 9]} data-m={i % 3 ? 's' : 'b'} hidden={i >= PER}>
          <a href={r(`/proyectos/${p.slug}/`)}>
            <div class="frame" data-reveal="clip" data-parallax="5" style={`view-transition-name:p-${p.slug}`}>
              <Image {...im(portada(p))} alt={p.titulo} widths={[640, 1024, 1600]} sizes="(max-width: 760px) 100vw, (max-width: 1100px) 60vw, 58vw" format="webp" quality={72} loading={i < 4 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} />
            </div>
            <span class="card-cap">
              <span class="serif cap">{p.nombre}</span>
              <span class="small">{meta(p)}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
    <nav class="pagination small num" aria-label="Páginas del listado" data-pages>
      <button class="pg-step" data-page-step="-1" aria-label="Página anterior"><span class="arr-l">←</span><span class="pg-word">Anterior</span></button>
      <span class="pg-nums" data-page-nums>
        {Array.from({ length: pages }, (_, k) => (
          <button class:list={['pg-num', { 'is-on': k === 0 }]} data-page={k} aria-label={`Página ${k + 1}`} aria-current={k === 0 ? 'page' : undefined}>{String(k + 1).padStart(2, '0')}</button>
        ))}
      </span>
      <button class="pg-step" data-page-step="1" aria-label="Página siguiente"><span class="pg-word">Siguiente</span><span class="arr">→</span></button>
    </nav>

    <div class="index grid12" data-index hidden>
      <div class="table">
        <div class="row head small mut" role="group" aria-label="Ordenar el índice">
          <span>Nº</span>
          <button data-sort="nombre" aria-label="Ordenar por nombre">Proyecto <i data-arrow="nombre" aria-hidden="true"></i></button>
          <span>Tipo</span><span>Lugar</span>
          <button data-sort="anio" aria-label="Ordenar por año">Año <i data-arrow="anio" aria-hidden="true"></i></button>
          <button data-sort="m2" class="right" aria-label="Ordenar por superficie">m² <i data-arrow="m2" aria-hidden="true"></i></button>
        </div>
        <ol class="rows" data-rows>
          {proyectos.map((p, i) => (
            <li data-cat={p.categoria} data-nombre={p.nombre} data-anio={p.anio ?? 0} data-m2={p.m2 ?? 0} data-i={i}>
              <a href={r(`/proyectos/${p.slug}/`)} class="row" data-hover={i}>
                <span class="nr mut num"><i class="mark"></i><span data-nr>{String(i + 1).padStart(2, '0')}</span></span>
                <span class="serif rname">{p.nombre}</span>
                <span class="d">{tipo(p)}</span>
                <span class="d">{ciudad(p)}</span>
                <span class="num yr">{p.anio ?? '—'}</span>
                <span class="num right d">{p.m2 ? fmt.format(p.m2) : '—'}</span>
                <span class="m small mut">{[tipo(p), ciudad(p), p.m2 && `${fmt.format(p.m2)} m²`].filter(Boolean).join(' · ')}</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
      <aside class="preview" aria-hidden="true">
        <div class="frame preview-img">
          <img src={previews[0].src} alt="" data-prev-img loading="lazy" decoding="async" />
        </div>
        <span class="small mut" data-prev-cap>{proyectos[0].nombre} · {ciudad(proyectos[0])}</span>
      </aside>
    </div>
  </section>
  <script type="application/json" data-caps set:html={JSON.stringify(proyectos.map((p, i) => ({ cap: `${p.nombre} · ${ciudad(p)}`, src: previews[i].src })))} />
</Base>

<script>
  import { gsap, ScrollTrigger, reduced, ease } from '../../scripts/motion.ts';
  import { Flip } from 'gsap/Flip';
  gsap.registerPlugin(Flip);

  const grid = document.querySelector<HTMLElement>('[data-grid]')!;
  const index = document.querySelector<HTMLElement>('[data-index]')!;
  const rowsEl = document.querySelector<HTMLElement>('[data-rows]')!;
  const cards = Array.from(grid.querySelectorAll<HTMLLIElement>('.card'));
  const rows = () => Array.from(rowsEl.querySelectorAll<HTMLElement>('li'));
  const total = document.querySelector('[data-total]')!;
  const caps: { cap: string; src: string }[] = JSON.parse(document.querySelector('[data-caps]')!.textContent!);
  let filter = 'all';

  function press(sel: string, btn: HTMLElement) {
    document.querySelectorAll<HTMLElement>(sel).forEach((b) => {
      b.classList.toggle('is-on', b === btn);
      b.setAttribute('aria-pressed', String(b === btn));
    });
  }
  function renumber() {
    let n = 0;
    rows().forEach((r) => {
      if (!r.classList.contains('is-hidden')) r.querySelector('[data-nr]')!.textContent = String(++n).padStart(2, '0');
    });
    total.textContent = String(n);
    return n;
  }
  const strip = document.querySelector<HTMLElement>('.filters')!;
  const edge = () => strip.classList.toggle('has-more', strip.scrollLeft + strip.clientWidth < strip.scrollWidth - 4);
  strip.addEventListener('scroll', edge, { passive: true });
  window.addEventListener('resize', edge);
  edge();
  // El filtro activo queda siempre a la vista
  strip.addEventListener('click', (e) => (e.target as HTMLElement).closest('button')?.scrollIntoView({ inline: 'nearest', block: 'nearest', behavior: reduced ? 'auto' : 'smooth' }));
  const status = document.querySelector('[data-status]')!;
  const say = (t: string) => { status.textContent = ''; requestAnimationFrame(() => (status.textContent = t)); };

  /* Paginación del mosaico: cada página reparte las formas del patrón entre los proyectos visibles */
  const PER = Number(grid.dataset.per);
  const SHAPES = 'abcdefghi';
  const pagesNav = document.querySelector<HTMLElement>('[data-pages]')!;
  const numsEl = document.querySelector<HTMLElement>('[data-page-nums]')!;
  let page = Math.max(0, Number(new URLSearchParams(location.search).get('p') ?? 1) - 1);
  const match = (el: HTMLElement) => filter === 'all' || el.dataset.cat === filter;

  function layout(animate: boolean) {
    const vis = cards.filter(match);
    const pages = Math.max(1, Math.ceil(vis.length / PER));
    page = Math.min(page, pages - 1);
    const shown = vis.slice(page * PER, page * PER + PER);
    cards.forEach((c) => (c.hidden = !shown.includes(c)));
    shown.forEach((c, k) => { c.dataset.shape = SHAPES[k % 9]; c.dataset.m = k % 3 ? 's' : 'b'; });
    numsEl.innerHTML = Array.from({ length: pages }, (_, k) =>
      `<button class="pg-num${k === page ? ' is-on' : ''}" data-page="${k}" aria-label="Página ${k + 1}"${k === page ? ' aria-current="page"' : ''}>${String(k + 1).padStart(2, '0')}</button>`).join('');
    pagesNav.hidden = pages < 2;
    pagesNav.querySelector<HTMLButtonElement>('[data-page-step="-1"]')!.disabled = page === 0;
    pagesNav.querySelector<HTMLButtonElement>('[data-page-step="1"]')!.disabled = page === pages - 1;
    const url = new URL(location.href);
    if (page) url.searchParams.set('p', String(page + 1)); else url.searchParams.delete('p');
    history.replaceState(null, '', url);
    ScrollTrigger.refresh();
    if (animate) {
      if (reduced) gsap.fromTo(shown, { opacity: 0.3 }, { opacity: 1, duration: 0.3 });
      else gsap.fromTo(shown, { opacity: 0, y: 40 }, { opacity: 1, y: 0, duration: 0.9, stagger: 0.04, ease, clearProps: 'transform,opacity' });
    }
    return vis.length;
  }
  function goPage(k: number) {
    page = k;
    layout(true);
    const top = document.querySelector<HTMLElement>('.bar')!;
    const lenis = (window as any).__lenis;
    if (lenis) lenis.scrollTo(top, { offset: -12 }); else top.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth' });
  }
  numsEl.addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest<HTMLElement>('[data-page]'); if (b) goPage(Number(b.dataset.page)); });
  pagesNav.querySelectorAll<HTMLElement>('[data-page-step]').forEach((b) => b.addEventListener('click', () => goPage(page + Number(b.dataset.pageStep))));
  layout(false);

  document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((btn) =>
    btn.addEventListener('click', () => {
      filter = btn.dataset.filter!;
      press('[data-filter]', btn);
      page = 0;
      rows().forEach((r) => r.classList.toggle('is-hidden', !match(r)));
      renumber();
      const n = grid.hidden ? rows().filter((r) => !r.classList.contains('is-hidden')).length : layout(true);
      if (grid.hidden) layout(false);
      say(`${n} ${n === 1 ? 'proyecto' : 'proyectos'}${filter === 'all' ? '' : ` en ${btn.textContent!.replace(/\d+$/, '').trim()}`}`);
      const first = rows().find((r) => !r.classList.contains('is-hidden'));
      if (first) highlight(Number(first.dataset.i));
    }),
  );

  document.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((btn) =>
    btn.addEventListener('click', () => {
      press('[data-view]', btn);
      const isIndex = btn.dataset.view === 'index';
      grid.hidden = isIndex;
      pagesNav.style.display = isIndex ? 'none' : '';
      index.hidden = !isIndex;
      ScrollTrigger.refresh();
      if (!reduced) gsap.from(isIndex ? rows() : cards.filter((c) => !c.hidden), { opacity: 0, y: 16, duration: 0.8, stagger: 0.04, ease });
    }),
  );

  /* Orden de la tabla */
  let sortKey = '';
  let dir = 1;
  document.querySelectorAll<HTMLButtonElement>('[data-sort]').forEach((btn) =>
    btn.addEventListener('click', () => {
      const key = btn.dataset.sort!;
      dir = sortKey === key ? -dir : key === 'nombre' ? 1 : -1;
      sortKey = key;
      const val = (r: HTMLElement) => (key === 'nombre' ? r.dataset.nombre! : Number(r.dataset[key]));
      const sorted = rows().sort((a, b) => (val(a) > val(b) ? 1 : val(a) < val(b) ? -1 : 0) * dir);
      const state = reduced ? null : Flip.getState(sorted);
      sorted.forEach((r) => rowsEl.appendChild(r));
      document.querySelectorAll<HTMLElement>('[data-arrow]').forEach((a) => (a.textContent = a.dataset.arrow === key ? (dir === 1 ? '↑' : '↓') : ''));
      renumber();
      say(`Ordenado por ${btn.textContent!.trim().replace(/[↑↓]/, '').trim().toLowerCase()}, ${dir === 1 ? 'ascendente' : 'descendente'}`);
      if (state) Flip.from(state, { duration: 0.6, ease });
    }),
  );

  /* Vista previa fija: la obra de la fila señalada */
  const prevImg = document.querySelector<HTMLImageElement>('[data-prev-img]')!;
  const prevCap = document.querySelector('[data-prev-cap]')!;
  function highlight(i: number) {
    rows().forEach((r) => r.classList.toggle('is-marked', Number(r.dataset.i) === i));
    prevCap.textContent = caps[i].cap;
    if (prevImg.src.endsWith(caps[i].src)) return;
    const next = new Image();
    next.onload = () => {
      prevImg.src = caps[i].src;
      if (!reduced) gsap.fromTo(prevImg, { opacity: 0.4 }, { opacity: 1, duration: 0.35 });
    };
    next.src = caps[i].src;
  }
  rowsEl.querySelectorAll<HTMLElement>('[data-hover]').forEach((a) => {
    const i = Number(a.dataset.hover);
    a.addEventListener('mouseenter', () => highlight(i));
    a.addEventListener('focus', () => highlight(i));
  });
  highlight(0);
</script>

<style>
  .intro { padding-top: 120px; row-gap: 16px; align-items: end; }
  .title { grid-column: 1 / span 7; font-size: clamp(56px, 8.4vw, 120px); line-height: 1; letter-spacing: -0.02em; }
  .title sup { font-family: var(--sans); font-size: 14px; letter-spacing: 0; vertical-align: top; margin-left: 8px; color: var(--mut); }
  .intro-text { grid-column: 9 / span 4; }

  .bar {
    margin: 88px var(--pad) 0; padding: 6px 0;
    border-block: 1px solid var(--line);
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px 24px;
    font-size: 14px;
  }
  .filters { display: flex; gap: 32px; overflow-x: auto; max-width: 100%; scrollbar-width: none; }
  .views { display: flex; gap: 20px; }
  .chip, .chip-view { padding: 12px 0; white-space: nowrap; color: var(--mut); transition: color 0.3s; }
  .chip { display: flex; gap: 6px; align-items: baseline; }
  .chip .count { font-size: 11px; color: var(--mut); }
  .chip:hover, .chip-view:hover, .chip-view.is-on { color: var(--ink); }
  .chip.is-on { color: var(--ink); text-decoration: underline; text-decoration-color: var(--yellow); text-decoration-thickness: 2px; text-underline-offset: 6px; }

  .list { padding-top: 56px; padding-bottom: var(--sec); }
  /* Mosaico: 12 columnas, filas de alto fijo, patrón a–i que encaja en 5 filas */
  .grid { list-style: none; margin: 0; padding: 0; gap: 10px; grid-auto-rows: clamp(190px, 19vw, 340px); grid-auto-flow: dense; }
  .card { grid-column: span 4; grid-row: span 1; }
  .card[data-shape='a'] { grid-column: span 7; grid-row: span 2; }
  .card[data-shape='b'], .card[data-shape='c'] { grid-column: span 5; }
  .card[data-shape='g'] { grid-column: span 5; grid-row: span 2; }
  .card[data-shape='h'], .card[data-shape='i'] { grid-column: span 7; }
  .rows li.is-hidden { display: none; }
  .card a { position: relative; display: block; height: 100%; color: #fff; }
  .card .frame { height: 100%; }
  .card-cap {
    position: absolute; inset: auto 0 0 0; padding: 48px 20px 16px;
    display: flex; flex-direction: column; gap: 2px;
    background: linear-gradient(to top, rgba(20, 20, 18, 0.62), transparent);
    opacity: 0; transform: translateY(8px);
    transition: opacity 0.5s var(--ease-out), transform 0.6s var(--ease-out);
    pointer-events: none;
  }
  .card a:hover .card-cap, .card a:focus-visible .card-cap { opacity: 1; transform: none; }
  .card-cap .small { opacity: 0.82; }
  @media (hover: none) { .card-cap { opacity: 1; transform: none; } }
  .cap { font-size: clamp(19px, 1.55vw, 22px); line-height: 1.25; }

  .pagination { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-top: 48px; padding-top: 20px; border-top: 1px solid var(--line); }
  .pg-nums { display: flex; flex-wrap: wrap; gap: 4px; }
  .pagination button { min-width: 44px; height: 44px; padding: 0 10px; display: inline-flex; align-items: center; justify-content: center; gap: 10px; color: var(--mut); transition: color 0.3s, background-color 0.3s; }
  .pagination button:hover:not(:disabled) { color: var(--ink); }
  .pagination :global(.pg-num.is-on) { color: var(--bg); background: var(--ink); }
  .pagination button:disabled { opacity: 0.3; cursor: default; }

  .table { grid-column: 1 / span 8; }
  .row { display: grid; grid-template-columns: 56px minmax(0, 1fr) 130px 160px 64px 72px; gap: 16px; align-items: baseline; }
  .head { font-size: 12px; padding-bottom: 12px; border-bottom: 1px solid var(--line); }
  .head button { text-align: left; color: inherit; }
  .head button:hover { color: var(--ink); }
  .head i { font-style: normal; }
  .right { text-align: right !important; justify-self: end; }
  .rows { list-style: none; margin: 0; padding: 0; }
  .rows .row { padding: 18px 0; border-bottom: 1px solid var(--line); font-size: 14px; }
  .rows .row:hover { color: var(--ink); }
  .nr { display: flex; align-items: center; gap: 8px; }
  .mark { width: 7px; height: 7px; background: transparent; display: block; transition: background-color 0.25s; }
  .is-marked .mark { background: var(--yellow); }
  .rname { font-size: 22px; line-height: 1.2; }
  .m { display: none; }

  .preview { grid-column: 10 / span 3; position: sticky; top: 24px; display: flex; flex-direction: column; gap: 12px; }
  .preview-img { aspect-ratio: 4 / 5; }

  @media (max-width: 1100px) {
    .grid { grid-auto-rows: clamp(160px, 24vw, 280px); }
    .table { grid-column: 1 / span 12; }
    .preview { display: none; }
  }
  @media (max-width: 760px) {
    .intro { padding-top: 48px; }
    .title, .intro-text { grid-column: 1 / -1; }
    .bar { margin-top: 40px; }
    .filters { gap: 20px; margin-right: calc(var(--pad) * -1); padding-right: var(--pad); scroll-padding-inline: var(--pad); }
    /* Indicio de que la tira sigue: borde que se desvanece mientras quede contenido a la derecha */
    .filters.has-more { mask-image: linear-gradient(to right, #000 calc(100% - 56px), transparent); }
    .list { padding-top: 32px; }
    .grid { gap: 6px; grid-auto-rows: 30vw; }
    .card, .card[data-shape] { grid-column: span 2; grid-row: span 2; }
    .card[data-m='b'] { grid-column: 1 / -1; }
    .card-cap { padding: 32px 12px 10px; }
    .card-cap .cap { font-size: 16px; }
    .card[data-m='s'] .card-cap .small { display: none; }
    .pg-word { display: none; }
    .table { grid-column: 1 / -1; }
    .head { display: none; }
    .rows .row { grid-template-columns: 1fr auto; gap: 2px 12px; padding: 16px 0; }
    .nr, .d { display: none; }
    .rname { font-size: 20px; }
    .yr { font-size: 13px; }
    .m { display: block; grid-column: 1 / -1; }
  }
</style>
