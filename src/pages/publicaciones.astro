---
import { r } from '../lib/ruta';
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import Hemeroteca from '../components/Hemeroteca.astro';
import { foto, im } from '../data/proyectos';
import { publicaciones, recientes, medios, destacadas, anio } from '../data/publicaciones';

const revistas = publicaciones.filter((p) => p.formato === 'Revista').length;
const digitales = publicaciones.length - revistas;
const desde = Math.min(...publicaciones.map(anio));
const filtros = [
  { id: 'all', label: 'Todas', n: publicaciones.length },
  { id: 'Revista', label: 'Revistas impresas', n: revistas },
  { id: 'Digital', label: 'Prensa digital', n: digitales },
];
// Foto vertical de cada obra destacada (la portada de la ficha suele ser horizontal)
const fotos = destacadas.map((d, i) => foto(d.slug, i === 1 ? 1 : 0, 'P'));
---
<Base title="Publicaciones y prensa" current="estudio" ogImage={fotos[0].src} description={`${publicaciones.length} apariciones en prensa desde ${desde}: obras de NAN Arquitectos publicadas en ArchDaily, Arqa, Architizer, Plataforma Arquitectura, Proyecto Contract y otras revistas.`}>
  <section class="intro pad grid12">
    <nav class="crumbs small" aria-label="Ruta">
      <a href={r('/estudio/')} class="mut ulink">Estudio</a><span class="mut" aria-hidden="true">/</span><span aria-current="page">Publicaciones</span>
    </nav>
    <h1 class="title" data-pb-title>Publicaciones<sup class="num">{publicaciones.length}</sup></h1>
    <div class="intro-text">
      <p>Desde {desde}, revistas de arquitectura e interiorismo y medios digitales de referencia han publicado la obra del estudio.</p>
      <dl class="stats small">
        <div><dt class="mut">Revistas impresas</dt><dd class="num">{revistas}</dd></div>
        <div><dt class="mut">Prensa digital</dt><dd class="num">{digitales}</dd></div>
        <div><dt class="mut">Medios</dt><dd class="num">{medios.length}</dd></div>
      </dl>
    </div>
  </section>

  <section class="dest pad" aria-labelledby="dest-t">
    <h2 id="dest-t" class="sr-only">Publicaciones destacadas</h2>
    <ul class="dest-grid grid12">
      {destacadas.map((d, i) => (
        <li class="dest-i" style={`--mt:${['0', '120px', '40px'][i]}`}>
          <a href={r(`/proyectos/${d.slug}/`)} class="dest-img" tabindex="-1" aria-hidden="true">
            <div class="frame" data-reveal="clip" data-parallax="5" style="aspect-ratio: 4 / 5">
              <Image {...im(fotos[i])} alt="" widths={[640, 1024, 1400]} sizes="(max-width: 760px) 100vw, 32vw" format="webp" quality={72} loading={i === 0 ? 'eager' : 'lazy'} />
            </div>
          </a>
          <div class="dest-cap" data-reveal="text">
            <p class="dest-m serif">{d.medio}</p>
            <p><a href={r(`/proyectos/${d.slug}/`)} class="ulink">{d.obra}</a> <span class="mut">· {d.anio}</span></p>
            <p class="small mut">También en {d.tambien}</p>
            <a href={d.url} target="_blank" rel="noopener" class="dest-go small">Leer el artículo en {d.medio} <span class="arr-ne" aria-hidden="true">↗</span><span class="sr-only"> (se abre en otra pestaña)</span></a>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="medios pad grid12" aria-labelledby="medios-t">
    <h2 id="medios-t" class="label small mut">En sus páginas</h2>
    <ul class="medios-list" data-reveal="text">
      {medios.map((m) => <li><span class="serif">{m.medio}</span>{m.n > 1 && <sup class="num">{m.n}</sup>}</li>)}
    </ul>
  </section>

  <section class="hem pad" aria-labelledby="hem-t">
    <div class="hem-head">
      <h2 id="hem-t" class="h2">Hemeroteca</h2>
      <div class="filters small" role="group" aria-label="Filtrar publicaciones">
        {filtros.map((f, i) => (
          <button class:list={['chip', { 'is-on': i === 0 }]} data-pf={f.id} aria-pressed={i === 0 ? 'true' : 'false'}>
            <span>{f.label}</span><span class="count num">{f.n}</span>
          </button>
        ))}
      </div>
    </div>
    <p class="sr-only" role="status" data-pf-status></p>
    <div data-hem>
      <Hemeroteca items={recientes} />
    </div>
  </section>

  <section class="pb-cta pad grid12">
    <p class="cta-t">¿Escribe sobre arquitectura o interiorismo?</p>
    <div class="cta-side">
      <p class="mut">Para material gráfico, planos o una entrevista con el estudio, escríbanos.</p>
      <div class="cta-actions">
        <a href="mailto:info@nanarquitectos.com?subject=Prensa" class="btn">Contacto de prensa <span class="arr">→</span></a>
        <a href={r('/proyectos/')} class="btn-ghost">Ver proyectos</a>
      </div>
    </div>
  </section>
</Base>

<script>
  import { gsap, ScrollTrigger, reduced, ease } from '../scripts/motion.ts';

  if (!reduced) gsap.from('[data-pb-title]', { y: 40, opacity: 0, duration: 1.5, ease, delay: 0.15 });

  // Filtro por formato: oculta filas y los años que quedan vacíos
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-pf]'));
  const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-hem] [data-formato]'));
  const years = Array.from(document.querySelectorAll<HTMLElement>('[data-hem] [data-year]'));
  const status = document.querySelector('[data-pf-status]')!;
  chips.forEach((c) =>
    c.addEventListener('click', () => {
      const f = c.dataset.pf!;
      chips.forEach((x) => { x.classList.toggle('is-on', x === c); x.setAttribute('aria-pressed', String(x === c)); });
      rows.forEach((r) => (r.hidden = f !== 'all' && r.dataset.formato !== f));
      years.forEach((y) => (y.hidden = !y.querySelector('[data-formato]:not([hidden])')));
      const n = rows.filter((r) => !r.hidden).length;
      status.textContent = `${n} publicaciones`;
      if (!reduced) gsap.fromTo(years.filter((y) => !y.hidden), { opacity: 0, y: 12 }, { opacity: 1, y: 0, duration: 0.7, stagger: 0.04, ease });
      ScrollTrigger.refresh();
    }),
  );
</script>

<style>
  .intro { padding-top: 120px; row-gap: 16px; align-items: end; }
  .crumbs { grid-column: 1 / -1; display: flex; gap: 10px; }
  .title { grid-column: 1 / span 7; font-size: clamp(56px, 8.4vw, 120px); line-height: 1; letter-spacing: -0.02em; }
  .title sup { font-family: var(--sans); font-size: 14px; letter-spacing: 0; vertical-align: top; margin-left: 8px; color: var(--mut); }
  .intro-text { grid-column: 9 / span 4; display: flex; flex-direction: column; gap: 24px; }
  .stats { margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--line); }
  .stats div { padding-top: 12px; display: flex; flex-direction: column; gap: 4px; }
  .stats dd { margin: 0; font-family: var(--serif); font-weight: 300; font-size: 32px; line-height: 1; }

  .dest { padding-top: 120px; }
  .dest-grid { list-style: none; margin: 0; padding: 0; row-gap: 56px; align-items: start; }
  .dest-i { grid-column: span 4; margin-top: var(--mt); display: flex; flex-direction: column; gap: 18px; }
  .dest-cap { display: flex; flex-direction: column; gap: 6px; }
  .dest-m { font-size: clamp(28px, 2.6vw, 38px); line-height: 1.1; letter-spacing: -0.01em; }
  .dest-go { align-self: flex-start; margin-top: 10px; display: inline-flex; gap: 6px; padding-bottom: 2px; border-bottom: 1px solid var(--line); transition: border-color 0.4s; }
  .dest-go:hover { color: var(--ink); border-color: var(--ink); }
  .arr-ne { display: inline-block; transition: transform 0.55s var(--ease-out); }
  .dest-go:hover .arr-ne { transform: translate(3px, -3px); }

  .medios { padding-top: var(--sec); row-gap: 24px; }
  .label { grid-column: 1 / span 3; font-family: var(--sans); font-weight: 400; font-size: 13px; border-top: 1px solid var(--line); padding-top: 20px; }
  .medios-list { grid-column: 4 / span 9; list-style: none; margin: 0; padding: 16px 0 0; border-top: 1px solid var(--line); display: flex; flex-wrap: wrap; gap: 0 0.5em; font-size: clamp(28px, 3.4vw, 50px); line-height: 1.25; letter-spacing: -0.01em; }
  .medios-list li { font-weight: 300; color: var(--mut); transition: color 0.4s; }
  .medios-list li:hover { color: var(--ink); }
  .medios-list li:not(:last-child)::after { content: '·'; margin-left: 0.5em; color: var(--line); }
  .medios-list sup { font-family: var(--sans); font-size: 12px; letter-spacing: 0; vertical-align: top; margin-left: 4px; }

  .hem { padding-top: var(--sec); }
  .hem-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 16px 32px; padding-bottom: 40px; }
  .filters { display: flex; gap: 28px; font-size: 14px; overflow-x: auto; scrollbar-width: none; }
  .chip { display: flex; gap: 6px; align-items: baseline; padding: 10px 0; white-space: nowrap; color: var(--mut); transition: color 0.3s; }
  .chip .count { font-size: 11px; }
  .chip:hover { color: var(--ink); }
  .chip.is-on { color: var(--ink); text-decoration: underline; text-decoration-color: var(--yellow); text-decoration-thickness: 2px; text-underline-offset: 6px; }
  .chip:active { transform: scale(0.97); }

  .pb-cta { padding-block: var(--sec); row-gap: 32px; align-items: end; }
  .cta-t { grid-column: 1 / span 7; font-family: var(--serif); font-weight: 300; font-size: clamp(36px, 4.6vw, 68px); line-height: 1.05; letter-spacing: -0.02em; text-wrap: balance; }
  .cta-side { grid-column: 9 / span 4; display: flex; flex-direction: column; gap: 20px; }
  .cta-actions { display: flex; flex-wrap: wrap; gap: 10px; }

  @media (max-width: 1100px) {
    .title { grid-column: 1 / -1; }
    .intro-text { grid-column: 1 / span 8; }
    .dest-i { grid-column: span 6; }
    .dest-i:nth-child(3) { grid-column: 4 / span 6; }
    .cta-t, .cta-side { grid-column: 1 / -1; }
  }
  @media (max-width: 760px) {
    .intro { padding-top: 48px; }
    .intro-text { grid-column: 1 / -1; }
    .dest { padding-top: 64px; }
    .dest-grid { row-gap: 48px; }
    .dest-i, .dest-i:nth-child(3) { grid-column: 1 / -1; margin-top: 0; }
    .dest-i:nth-child(2) { grid-column: 2 / span 3; }
    .label, .medios-list { grid-column: 1 / -1; }
    .label { border-top: 0; padding-top: 0; }
    .medios-list { font-size: 26px; }
    .hem-head { padding-bottom: 24px; }
    .filters { flex-wrap: wrap; gap: 0 20px; width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    html:not(.force-motion) .arr-ne { transition: none; }
  }
</style>
