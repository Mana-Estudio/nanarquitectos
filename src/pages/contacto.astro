---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { foto, im } from '../data/proyectos';
import { contacto } from '../data/estudio';

const img = foto('oficina-nan-arquitectos', 2, 'L');
const pasos = ['Tipo de proyecto', 'Alcance', 'El espacio', 'Plazo y presupuesto', 'Sus datos'];
---
<Base title="Contacto" current="contacto" description="Contacte con NAN Arquitectos en Pontevedra: solicite presupuesto para su proyecto de arquitectura, interiorismo u obra.">
  <section class="ct pad grid12">
    <h1 class="ct-title display" data-ct-title>Hablemos de su proyecto.</h1>

    <button class="quote-card" data-quote>
      <span class="qc-top">
        <span class="qc-t">Solicitar presupuesto</span>
        <span class="qc-go" aria-hidden="true"><span class="arr">→</span></span>
      </span>
      <span class="qc-d mut">Cinco preguntas breves. Le respondemos en 24–48 h laborables.</span>
      <ol class="qc-steps small" aria-hidden="true">
        {pasos.map((p, i) => <li style={`--d:${i * 60}ms`}><span class="num">{String(i + 1).padStart(2, '0')}</span>{p}</li>)}
      </ol>
    </button>

    <div class="ct-data">
      <div class="dat" data-reveal="text">
        <p class="small mut">{contacto.nuevos.label}</p>
        <a href={contacto.nuevos.href} class="dat-big">{contacto.nuevos.tel}</a>
        <a href={contacto.nuevos.wa} target="_blank" rel="noopener" class="small ulink">Escribir por WhatsApp</a>
      </div>
      <div class="dat" data-reveal="text">
        <p class="small mut">{contacto.generales.label}</p>
        <a href={contacto.generales.href} class="dat-mid">{contacto.generales.tel}</a>
      </div>
      <div class="dat" data-reveal="text">
        <p class="small mut">Email</p>
        <span class="dat-row">
          <a href={`mailto:${contacto.email}`} class="dat-mid">{contacto.email}</a>
          <button class="copy small" data-copy={contacto.email} aria-label="Copiar email"><span class="roll"><span data-copy-t>Copiar</span><span aria-hidden="true">Copiar</span></span></button>
        </span>
      </div>
      <div class="dat" data-reveal="text">
        <p class="small mut">Estudio</p>
        <p class="dat-addr">{contacto.direccion[0]}<br />{contacto.direccion[1]}</p>
        <a href={contacto.mapa} target="_blank" rel="noopener" class="small ulink">Cómo llegar</a>
      </div>
      <div class="dat" data-reveal="text">
        <p class="small mut">Redes</p>
        <p class="redes">{contacto.redes.map((r) => <a href={r.href} target="_blank" rel="noopener" class="ulink">{r.label}</a>)}</p>
      </div>
    </div>
  </section>

  <div class="ct-img pad">
    <div class="frame" data-reveal="clip" data-parallax="7">
      <Image {...im(img)} alt="Oficina de NAN Arquitectos en la Plaza de España de Pontevedra" widths={[828, 1280, 1920, 2560]} sizes="100vw" format="webp" quality={72} />
    </div>
  </div>

  <p class="legal pad small mut">{contacto.titular}. Sus datos se usan solo para atender su solicitud y no se ceden a terceros. Puede ejercer sus derechos de acceso, rectificación y supresión escribiendo a {contacto.email}.</p>
</Base>

<script>
  import { gsap, reduced, ease } from '../scripts/motion.ts';
  if (!reduced) gsap.from('[data-ct-title]', { y: 40, opacity: 0, duration: 1.5, ease, delay: 0.15 });

  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) =>
    b.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(b.dataset.copy!); } catch { return; }
      b.querySelectorAll('span span').forEach((s) => (s.textContent = 'Copiado'));
      b.classList.add('is-ok');
      window.setTimeout(() => { b.querySelectorAll('span span').forEach((s) => (s.textContent = 'Copiar')); b.classList.remove('is-ok'); }, 2000);
    }),
  );
</script>

<style>
  .ct { padding-top: 120px; row-gap: 56px; align-items: start; }
  .ct-title { grid-column: 1 / -1; }

  .quote-card {
    grid-column: 1 / span 6; text-align: left;
    display: flex; flex-direction: column; gap: 16px; padding: 32px;
    background: var(--ink); color: var(--bg);
    transition: transform 0.6s var(--ease-out), background-color 0.5s;
  }
  .quote-card:hover { transform: translateY(-4px); }
  .quote-card:active { transform: scale(0.99); }
  .qc-top { display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .qc-t { font-family: var(--serif); font-weight: 300; font-size: clamp(30px, 3.2vw, 46px); line-height: 1.05; }
  .qc-go { width: 56px; height: 56px; flex: none; display: grid; place-items: center; border-radius: 50%; background: var(--yellow); color: var(--ink); font-size: 18px; transition: transform 0.6s var(--ease-out); }
  .quote-card:hover .qc-go { transform: rotate(-45deg); }
  .qc-d { color: var(--night-mut); }
  .qc-steps { list-style: none; margin: 16px 0 0; padding: 0; border-top: 1px solid rgba(236, 233, 227, 0.16); }
  .qc-steps li { display: flex; gap: 16px; padding: 12px 0; border-bottom: 1px solid rgba(236, 233, 227, 0.16); color: var(--night-mut); transition: color 0.4s var(--d), padding 0.5s var(--ease-out) var(--d); }
  .qc-steps .num { color: var(--yellow); }
  .quote-card:hover .qc-steps li { color: var(--night-ink); padding-left: 8px; }

  .ct-data { grid-column: 8 / span 5; display: flex; flex-direction: column; }
  .dat { display: flex; flex-direction: column; gap: 6px; padding: 20px 0; border-top: 1px solid var(--line); }
  .dat-big { font-family: var(--serif); font-weight: 300; font-size: clamp(32px, 3vw, 44px); line-height: 1.1; }
  .dat-mid { font-family: var(--serif); font-weight: 300; font-size: clamp(22px, 1.9vw, 28px); line-height: 1.2; }
  .dat-big:hover, .dat-mid:hover { color: var(--mut); }
  .dat-row { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 16px; }
  .copy { padding: 6px 10px; box-shadow: inset 0 0 0 1px var(--line); transition: background-color 0.3s, color 0.3s; }
  .copy:hover { box-shadow: inset 0 0 0 1px var(--ink); }
  .copy.is-ok { background: var(--yellow); box-shadow: none; }
  .dat-addr { font-size: 17px; }
  .redes { display: flex; flex-wrap: wrap; gap: 8px 20px; }

  .ct-img { padding-top: var(--sec); }
  .ct-img .frame { aspect-ratio: 21 / 9; }
  .legal { padding-top: 24px; padding-bottom: 80px; max-width: calc(80ch + var(--pad) * 2); }

  @media (max-width: 1100px) {
    .quote-card { grid-column: 1 / span 7; }
    .ct-data { grid-column: 8 / span 5; }
  }
  @media (max-width: 760px) {
    .ct { padding-top: 48px; row-gap: 32px; }
    .quote-card, .ct-data { grid-column: 1 / -1; }
    .quote-card { padding: 24px 20px; }
    .qc-go { width: 48px; height: 48px; }
    .ct-img { padding-top: 64px; }
    .ct-img .frame { aspect-ratio: 4 / 3; }
  }
</style>
