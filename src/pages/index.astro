---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { heroSlides, obrasHome, ciudad } from '../data/proyectos';

const servicios = [
  { name: 'Arquitectura', desc: 'Obra nueva y rehabilitación de viviendas y edificios. Proyecto básico y de ejecución, licencias y tramitación.' },
  { name: 'Interiorismo', desc: 'Reformas integrales, mobiliario a medida y selección de materiales, iluminación y acabados.' },
  { name: 'Clínicas y oficinas', desc: 'Distribución funcional, normativa sanitaria y accesibilidad para consultas, clínicas y espacios de trabajo.' },
  { name: 'Hostelería y comercio', desc: 'Restaurantes, tiendas y espacios de eventos con identidad propia, pensados para la operación diaria.' },
  { name: 'Dirección de obra', desc: 'Seguimiento en obra, coordinación de gremios y control de plazos y costes.' },
];
const total = String(heroSlides.length).padStart(2, '0');
---
<Base title="NAN Arquitectos" ogImage={heroSlides[0].imagen.src}>
  <h1 class="sr-only">NAN Arquitectos, estudio de arquitectura e interiorismo en Pontevedra</h1>

  <section class="hero" aria-label="Obras destacadas" aria-roledescription="carrusel">
    <div class="hero-media" data-hero>
      {heroSlides.map((s, i) => (
        <figure class:list={['slide', { 'is-active': i === 0 }]} data-slide data-name={s.proyecto.nombre} data-meta={`${ciudad(s.proyecto)} · ${s.proyecto.anio}`} data-href={`/proyectos/${s.proyecto.slug}/`} aria-hidden={i === 0 ? undefined : 'true'}>
          <Image src={s.imagen} alt={s.proyecto.titulo} widths={[828, 1280, 1920, 2560]} sizes="100vw" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} format="avif" quality={70} />
        </figure>
      ))}
    </div>
    <div class="hero-bar pad">
      <p class="hero-cap" data-hero-cap>
        <a href={`/proyectos/${heroSlides[0].proyecto.slug}/`} class="serif hero-name" data-hero-link>{heroSlides[0].proyecto.nombre}</a>
        <span class="small mut" data-hero-meta>{ciudad(heroSlides[0].proyecto)} · {heroSlides[0].proyecto.anio}</span>
      </p>
      <div class="hero-ctrl small num">
        <button class="mut" data-hero-prev aria-label="Obra anterior">Ant.</button>
        <span aria-live="polite"><span data-hero-index>01</span> / {total}</span>
        <button class="mut" data-hero-next aria-label="Obra siguiente">Sig.</button>
      </div>
    </div>
  </section>

  <section class="works pad" aria-labelledby="works-title">
    <div class="sec-head" data-reveal="text">
      <h2 id="works-title" class="h2">Obras seleccionadas</h2>
      <a href="/proyectos/" class="small-link">Todos los proyectos →</a>
    </div>
    <div class="grid12 works-grid">
      {obrasHome.map((o) => (
        <a href={`/proyectos/${o.proyecto.slug}/`} class="work" style={`--col:${o.col};--mt:${o.mt}`}>
          <div class="frame" data-reveal="img" style={`aspect-ratio:${o.ar};view-transition-name:p-${o.proyecto.slug}`}>
            <Image src={o.imagen} alt={o.proyecto.titulo} widths={[640, 1024, 1600, 2400]} sizes={o.col === '1 / -1' ? '100vw' : '(max-width: 760px) 100vw, 60vw'} format="avif" quality={72} />
          </div>
          <p class="work-cap">
            <span class="serif cap">{o.proyecto.nombre}</span>
            <span class="small mut">{o.proyecto.categoria} · {ciudad(o.proyecto)} · {o.proyecto.anio}</span>
          </p>
        </a>
      ))}
    </div>
  </section>

  <section class="block pad" id="estudio" aria-labelledby="estudio-label">
    <div class="grid12 rule" data-reveal="text">
      <h2 id="estudio-label" class="label small mut">Estudio</h2>
      <p class="text h2 lead">Hacemos arquitectura para que la vida ocurra dentro. Pocos materiales, luz natural y proporciones medidas; cuidamos cada detalle hasta que deja de notarse.</p>
      <p class="col-a">NAN es un estudio de arquitectura e interiorismo con sede en Pontevedra desde 2013. Proyectamos clínicas, restaurantes, comercios, oficinas y viviendas en Galicia, y acompañamos cada encargo desde el primer boceto hasta la entrega de llaves.</p>
      <p class="col-b small mut">Alberto F. Reiriz Paz<br />Vicente Pillado Domato</p>
    </div>
  </section>

  <section class="block pad" id="servicios" aria-labelledby="servicios-label">
    <div class="grid12 rule svc-head">
      <h2 id="servicios-label" class="label small mut">Servicios</h2>
    </div>
    <ol class="svc">
      {servicios.map((s, i) => (
        <li class="grid12" data-reveal="text">
          <span class="svc-num small mut num">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="svc-name h3">{s.name}</h3>
          <p class="svc-desc">{s.desc}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="block contact pad" id="contacto" aria-labelledby="contacto-title">
    <div class="grid12 rule">
      <p class="label small mut">Contacto</p>
      <div class="text contact-body" data-reveal="text">
        <h2 id="contacto-title" class="display">Cuéntenos<br />su proyecto.</h2>
        <a href="tel:+34691563366" class="serif h3 is-current contact-link">+34 691 563 366</a>
        <div class="contact-grid small">
          <div><div class="mut">Estudio</div><div>Plaza de España, 1, 1º Izq., of. 2<br />36002 Pontevedra</div></div>
          <div><div class="mut">Redes</div><div><a href="https://www.instagram.com/nanarquitectos/" target="_blank" rel="noopener">Instagram</a> · <a href="https://www.pinterest.es/nanarquitectos/" target="_blank" rel="noopener">Pinterest</a></div></div>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import { gsap, reduced, ease } from '../scripts/motion.ts';

  const slides = Array.from(document.querySelectorAll<HTMLElement>('[data-slide]'));
  const link = document.querySelector<HTMLAnchorElement>('[data-hero-link]')!;
  const meta = document.querySelector('[data-hero-meta]')!;
  const index = document.querySelector('[data-hero-index]')!;
  const cap = document.querySelector('[data-hero-cap]')!;
  const AUTOPLAY = 6000;
  let cur = 0;
  let timer: number | undefined;

  function show(next: number) {
    next = (next + slides.length) % slides.length;
    slides[cur].classList.remove('is-active');
    slides[cur].setAttribute('aria-hidden', 'true');
    slides[next].classList.add('is-active');
    slides[next].removeAttribute('aria-hidden');
    cur = next;
    const s = slides[next];
    const swap = () => {
      link.textContent = s.dataset.name!;
      link.href = s.dataset.href!;
      meta.textContent = s.dataset.meta!;
      index.textContent = String(next + 1).padStart(2, '0');
    };
    if (reduced) swap();
    else gsap.to(cap, { opacity: 0, y: -6, duration: 0.3, ease: 'power2.in', onComplete: () => { swap(); gsap.fromTo(cap, { opacity: 0, y: 6 }, { opacity: 1, y: 0, duration: 0.8, ease }); } });
    restart();
  }
  function restart() {
    window.clearTimeout(timer);
    if (!reduced) timer = window.setTimeout(() => show(cur + 1), AUTOPLAY);
  }
  document.querySelector('[data-hero-prev]')!.addEventListener('click', () => show(cur - 1));
  document.querySelector('[data-hero-next]')!.addEventListener('click', () => show(cur + 1));

  if (!reduced) {
    gsap.timeline({ defaults: { ease } })
      .from('[data-hero]', { clipPath: 'inset(6% 4% 6% 4%)', duration: 1.8 })
      .from('.hero-bar > *', { opacity: 0, y: 10, duration: 1.1, stagger: 0.08 }, 0.6);
  }
  restart();
</script>

<style>
  .h2 { font-family: var(--serif); font-weight: 300; font-size: clamp(30px, 3.4vw, 48px); line-height: 1.12; letter-spacing: -0.01em; }
  .h3 { font-family: var(--serif); font-weight: 300; font-size: clamp(24px, 2.4vw, 34px); line-height: 1.15; }
  .cap { font-size: clamp(19px, 1.55vw, 22px); }
  .display { font-size: clamp(46px, 7.2vw, 104px); line-height: 1.02; letter-spacing: -0.02em; }
  .small-link { font-size: 14px; white-space: nowrap; }

  /* Hero */
  .hero-media { position: relative; height: min(780px, calc(100svh - var(--head-h) - 72px)); min-height: 420px; background: #e7e4de; }
  .slide { position: absolute; inset: 0; opacity: 0; transition: opacity 1.4s var(--ease-out); }
  .slide.is-active { opacity: 1; }
  .slide :global(img) { width: 100%; height: 100%; object-fit: cover; transform: scale(1.05); transition: transform 7s linear; }
  .slide.is-active :global(img) { transform: scale(1); }
  .hero-bar { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding-top: 18px; }
  .hero-cap { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 16px; }
  .hero-name { font-size: clamp(19px, 1.55vw, 22px); }
  .hero-ctrl { display: flex; align-items: center; gap: 14px; white-space: nowrap; }
  .hero-ctrl button { padding: 8px 4px; }
  .hero-ctrl button:hover { color: var(--ink); }

  /* Obras */
  .works { padding-top: var(--sec); }
  .sec-head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding-bottom: 56px; }
  .works-grid { row-gap: 160px; align-items: start; }
  .work { grid-column: var(--col); margin-top: var(--mt); display: flex; flex-direction: column; gap: 14px; }
  .work:hover { color: var(--ink); }
  .work-cap { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 4px 16px; }

  /* Bloques con rótulo a la izquierda */
  .block { padding-top: var(--sec); }
  .rule { border-top: 1px solid var(--line); padding-top: 28px; row-gap: 28px; }
  .label { grid-column: 1 / span 3; font-family: var(--sans); font-weight: 400; font-size: 13px; }
  .text { grid-column: 4 / span 8; }
  .lead { line-height: 1.18; }
  .col-a { grid-column: 4 / span 4; margin-top: 48px; }
  .col-b { grid-column: 9 / span 3; margin-top: 48px; align-self: end; }

  .svc-head { padding-bottom: 56px; }
  .svc { list-style: none; margin: 0; padding: 0; }
  .svc li { row-gap: 10px; padding-block: 36px; border-top: 1px solid var(--line); align-items: baseline; }
  .svc-num { grid-column: 1 / span 1; }
  .svc-name { grid-column: 2 / span 5; }
  .svc-desc { grid-column: 8 / span 4; }

  .contact { padding-bottom: var(--sec); }
  .contact-body { display: flex; flex-direction: column; gap: 48px; }
  .contact-link { align-self: flex-start; text-underline-offset: 8px; }
  .contact-link:hover { color: var(--mut); }
  .contact-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 24px; font-size: 14px; }

  @media (max-width: 1100px) {
    .works-grid { row-gap: 110px; }
  }
  @media (max-width: 760px) {
    .hero-media { height: 560px; min-height: 0; }
    .sec-head { padding-bottom: 28px; }
    .works-grid { row-gap: 56px; }
    .work { grid-column: 1 / -1; margin-top: 0; }
    .work:nth-child(2) { grid-column: 2 / span 3; }
    .work:nth-child(3) { grid-column: 1 / span 3; }
    .work:nth-child(5) .frame { aspect-ratio: 4 / 3 !important; }
    .label, .text, .col-a, .col-b { grid-column: 1 / -1; }
    .col-a, .col-b { margin-top: 24px; }
    .contact-body { gap: 24px; }
    .svc-head { padding-bottom: 28px; }
    .svc li { padding-block: 22px; }
    .svc-num { grid-column: 1 / span 1; }
    .svc-name, .svc-desc { grid-column: 2 / span 3; }
  }
</style>
