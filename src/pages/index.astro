---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { proyectos, heroSlides, portada } from '../data/proyectos';

const destacados = proyectos;
const estudioImg = proyectos.find((p) => p.slug === 'pazo-buzaca')!.fotos[3];
const layout = ['a', 'b', 'c', 'd', 'e', 'f'];
---
<Base title="NAN Arquitectos" overlay ogImage={heroSlides[0].imagen.src}>
  <section class="hero" aria-label="Obras destacadas">
    <div class="hero-media" data-hero>
      {heroSlides.map((s, i) => (
        <figure class:list={['slide', { 'is-active': i === 0 }]} data-slide data-name={s.proyecto.nombre} data-meta={`${s.proyecto.categoria} · ${s.proyecto.anio}`} data-href={`/proyectos/${s.proyecto.slug}/`}>
          <Image
            src={s.imagen}
            alt={s.proyecto.titulo}
            widths={[828, 1280, 1920, 2560]}
            sizes="100vw"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'auto'}
            format="avif"
            quality={70}
          />
        </figure>
      ))}
      <div class="hero-shade" aria-hidden="true"></div>
    </div>

    <div class="hero-copy wrap">
      <h1 data-hero-title>
        <span class="line"><span>Arquitectura,</span></span>
        <span class="line"><span>interiorismo <em>y luz.</em></span></span>
      </h1>
      <p class="hero-sub" data-hero-fade>Estudio en Pontevedra desde 2013</p>
    </div>

    <a class="hero-caption wrap" href={`/proyectos/${heroSlides[0].proyecto.slug}/`} data-hero-caption data-hero-fade>
      <span class="hero-count"><span data-hero-index>01</span> / {String(heroSlides.length).padStart(2, '0')}</span>
      <span class="hero-name" data-hero-name>{heroSlides[0].proyecto.nombre}</span>
      <span class="hero-meta" data-hero-meta>{heroSlides[0].proyecto.categoria} · {heroSlides[0].proyecto.anio}</span>
      <span class="hero-bar" aria-hidden="true"><span data-hero-progress></span></span>
    </a>
  </section>

  <section class="works wrap" aria-labelledby="works-title">
    <div class="works-head" data-reveal="text">
      <h2 id="works-title">Obras seleccionadas</h2>
      <a href="/proyectos/" class="link-line">Ver todos los proyectos</a>
    </div>

    <div class="works-grid">
      {destacados.map((p, i) => (
        <a href={`/proyectos/${p.slug}/`} class:list={['work', `work-${layout[i]}`]}>
          <div class="frame" data-reveal="img" style={`view-transition-name: p-${p.slug}`}>
            <Image src={portada(p)} alt={p.titulo} widths={[640, 1024, 1600, 2400]} sizes="(max-width: 760px) 100vw, 60vw" format="avif" quality={72} />
          </div>
          <div class="work-info">
            <h3>{p.nombre}</h3>
            <p class="label">{p.categoria} · {p.lugar.split(',').pop()?.trim()} · {p.anio}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="studio wrap" id="estudio" aria-labelledby="studio-title">
    <h2 id="studio-title" class="studio-quote" data-reveal="text">
      <span>Diseño contemporáneo, dominio de la iluminación, juego de volúmenes y contraste de materiales.</span>
    </h2>
    <div class="studio-body">
      <div class="studio-text" data-reveal="text">
        <p>NAN Arquitectos es un estudio de arquitectura y diseño nacido en 2013, formado por Alberto F. Reiriz Paz y Vicente Pillado Domato. Con sede en Pontevedra, centra su actividad en proyectos de arquitectura, diseño e interiorismo para viviendas, oficinas y locales comerciales.</p>
        <p>La formación diversa de sus socios, y una red de colaboradores especializados, dan lugar a proyectos cuidados tanto a nivel estético como funcional.</p>
      </div>
      <div class="frame studio-img" data-parallax>
        <Image src={estudioImg} alt="Pabellón de eventos del Pazo da Buzaca" widths={[640, 1024, 1600, 2400]} sizes="(max-width: 760px) 100vw, 55vw" format="avif" quality={72} />
      </div>
    </div>
  </section>

  <section class="services wrap" id="servicios" aria-labelledby="services-title">
    <h2 id="services-title" class="sr-only">Servicios</h2>
    <ol class="service-list">
      <li data-reveal="text">
        <h3>Arquitectura</h3>
        <p>Obra nueva y rehabilitación de viviendas, locales y espacios de uso público, desde la idea hasta el proyecto de ejecución.</p>
      </li>
      <li data-reveal="text">
        <h3>Interiorismo</h3>
        <p>Clínicas, restaurantes, comercios, oficinas y viviendas. Espacios pensados a partir del uso, la luz y la materia.</p>
      </li>
      <li data-reveal="text">
        <h3>Gestión de obra</h3>
        <p>Construcción, mobiliario e iluminación coordinados por el mismo equipo que diseña el proyecto.</p>
      </li>
    </ol>
  </section>
</Base>

<script>
  import { gsap, reduced, ease } from '../scripts/motion.ts';

  const slides = Array.from(document.querySelectorAll<HTMLElement>('[data-slide]'));
  const caption = document.querySelector<HTMLAnchorElement>('[data-hero-caption]')!;
  const nameEl = document.querySelector('[data-hero-name]')!;
  const metaEl = document.querySelector('[data-hero-meta]')!;
  const indexEl = document.querySelector('[data-hero-index]')!;
  const progress = document.querySelector<HTMLElement>('[data-hero-progress]')!;
  const DURATION = 6;
  let current = 0;

  function show(next: number) {
    slides[current].classList.remove('is-active');
    slides[next].classList.add('is-active');
    current = next;
    const s = slides[next];
    gsap.to([nameEl, metaEl], {
      opacity: 0, y: -8, duration: 0.35, ease: 'power2.in',
      onComplete: () => {
        nameEl.textContent = s.dataset.name!;
        metaEl.textContent = s.dataset.meta!;
        indexEl.textContent = String(next + 1).padStart(2, '0');
        caption.href = s.dataset.href!;
        gsap.fromTo([nameEl, metaEl], { opacity: 0, y: 8 }, { opacity: 1, y: 0, duration: 0.8, ease, stagger: 0.05 });
      },
    });
    cycle();
  }

  function cycle() {
    gsap.fromTo(progress, { scaleX: 0 }, {
      scaleX: 1, duration: DURATION, ease: 'none',
      onComplete: () => show((current + 1) % slides.length),
    });
  }

  if (!reduced) {
    const tl = gsap.timeline({ defaults: { ease } });
    tl.from('[data-hero]', { clipPath: 'inset(10% 8% 10% 8%)', duration: 1.8 })
      .from('[data-hero-title] .line > span', { yPercent: 110, duration: 1.4, stagger: 0.1 }, 0.5)
      .from('[data-hero-fade]', { opacity: 0, y: 16, duration: 1.2, stagger: 0.1 }, 0.9)
      .add(cycle, 1.2);
  } else {
    progress.style.transform = 'scaleX(1)';
  }
</script>

<style>
  .hero { position: relative; height: 100svh; min-height: 560px; color: #fff; overflow: hidden; background: var(--ink); }
  .hero-media { position: absolute; inset: 0; }
  .slide { position: absolute; inset: 0; margin: 0; opacity: 0; transition: opacity 1.8s var(--ease-out); }
  .slide.is-active { opacity: 1; }
  .slide :global(img) { width: 100%; height: 100%; object-fit: cover; transform: scale(1.06); transition: transform 8s linear; }
  .slide.is-active :global(img) { transform: scale(1); }
  .hero-shade {
    position: absolute; inset: 0;
    background:
      linear-gradient(to bottom, rgb(0 0 0 / 0.38), transparent 26%),
      linear-gradient(to top, rgb(0 0 0 / 0.55), transparent 48%);
  }

  .hero-copy { position: absolute; left: 0; right: 0; bottom: clamp(7rem, 16vh, 10rem); }
  .hero h1 { font-size: clamp(3rem, 8.2vw, 6rem); font-weight: 340; letter-spacing: -0.03em; line-height: 0.98; }
  .hero h1 em { font-style: italic; font-weight: 300; }
  .line { display: block; overflow: hidden; padding-bottom: 0.08em; }
  .line > span { display: inline-block; }
  .hero-sub { margin-top: 1.25rem; font-size: 0.9375rem; color: rgb(255 255 255 / 0.85); }

  .hero-caption {
    position: absolute; left: 0; right: 0; bottom: 2rem;
    display: grid; grid-template-columns: auto 1fr auto; align-items: baseline; gap: 1.5rem;
    font-size: 0.875rem; color: rgb(255 255 255 / 0.9);
  }
  .hero-count { font-variant-numeric: tabular-nums; color: rgb(255 255 255 / 0.7); }
  .hero-name { font-family: var(--serif); font-size: 1.125rem; }
  .hero-meta { color: rgb(255 255 255 / 0.7); }
  .hero-bar { grid-column: 1 / -1; height: 1px; background: rgb(255 255 255 / 0.25); }
  .hero-bar span { display: block; height: 100%; background: #fff; transform-origin: left; transform: scaleX(0); }

  /* Obras */
  .works { padding-block: clamp(6rem, 14vw, 12rem) clamp(4rem, 10vw, 8rem); }
  .works-head { display: flex; justify-content: space-between; align-items: end; gap: 2rem; margin-bottom: clamp(3rem, 7vw, 6rem); }
  .works-head h2 { font-size: clamp(2.5rem, 6vw, 5rem); }
  .works-head a { font-size: 0.9375rem; white-space: nowrap; }

  .works-grid { display: grid; grid-template-columns: repeat(12, 1fr); column-gap: clamp(1rem, 2vw, 2rem); row-gap: clamp(4rem, 9vw, 9rem); }
  .work { display: block; }
  .work .frame { aspect-ratio: 4 / 3; }
  .work .frame :global(img) { transition: transform 1.2s var(--ease-out); }
  .work:hover .frame :global(img) { transform: scale(1.035); }
  .work-info { display: flex; flex-direction: column; gap: 0.4rem; margin-top: 1.1rem; }
  .work-info h3 { font-size: clamp(1.5rem, 2.4vw, 2rem); }
  .work-info .label { white-space: nowrap; }

  .work-a { grid-column: 1 / 9; }
  .work-b { grid-column: 9 / 13; align-self: end; }
  .work-b .frame { aspect-ratio: 3 / 4; }
  .work-c { grid-column: 2 / 6; }
  .work-c .frame { aspect-ratio: 4 / 5; }
  .work-d { grid-column: 7 / 13; margin-top: 12vw; }
  .work-d .frame { aspect-ratio: 5 / 4; }
  .work-e { grid-column: 1 / 6; }
  .work-e .frame { aspect-ratio: 4 / 5; }
  .work-f { grid-column: 7 / 12; margin-top: 8vw; }
  .work-f .frame { aspect-ratio: 4 / 5; }

  /* Estudio */
  .studio { padding-block: clamp(5rem, 12vw, 10rem); border-top: 1px solid var(--line); }
  .studio-quote { font-size: clamp(2rem, 4.6vw, 4.25rem); line-height: 1.08; max-width: 22ch; font-weight: 340; }
  .studio-body { display: grid; grid-template-columns: repeat(12, 1fr); gap: clamp(1rem, 2vw, 2rem); margin-top: clamp(3rem, 8vw, 7rem); align-items: start; }
  .studio-text { grid-column: 1 / 5; display: grid; gap: 1.25rem; color: var(--ink-2); max-width: 42ch; }
  .studio-img { grid-column: 6 / 13; aspect-ratio: 3 / 2; }

  /* Servicios */
  .services { padding-block: 0 clamp(6rem, 14vw, 12rem); }
  .service-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .service-list li {
    display: grid; grid-template-columns: repeat(12, 1fr); gap: clamp(1rem, 2vw, 2rem);
    padding-block: clamp(2rem, 4vw, 3.25rem); border-bottom: 1px solid var(--line);
  }
  .service-list h3 { grid-column: 1 / 7; font-size: clamp(2rem, 4.5vw, 3.75rem); }
  .service-list p { grid-column: 8 / 13; color: var(--ink-2); align-self: center; max-width: 40ch; }

  @media (max-width: 760px) {
    .hero-caption { grid-template-columns: auto 1fr; }
    .hero-meta { display: none; }
    .works-head { flex-direction: column; align-items: start; }
    .works-grid > .work { grid-column: 1 / -1; margin-top: 0; }
    .work-b, .work-c, .work-d, .work-e, .work-f { align-self: auto; }
    .studio-text, .studio-img { grid-column: 1 / -1; }
    .service-list h3, .service-list p { grid-column: 1 / -1; }
  }
</style>
