---
// Firma de Maná para el pie de todas las webs de la agencia.
// Autocontenida: el logotipo «maná» va en SVG (Bricolage Grotesque 600 convertida a trazados), sin fuentes externas.
// Se integra en la fila inferior del pie (junto al copyright y los legales), como un elemento más: no agrega líneas ni alto.
// Hereda color y tamaño de esa fila (currentColor, em); la tilde va siempre en el azul de Maná (#56B3F2).
// El enlace lleva nofollow: un link repetido en el pie de muchas webs distintas es un «esquema de enlaces» para Google.
// Movimiento sutil: al entrar en pantalla las letras suben en cascada y la tilde se posa; al pasar el cursor, una ola corta.
// Sin JS se ve completa y quieta. Todo se apaga con prefers-reduced-motion.
// Uso: <FirmaMana cliente="gorkavillanueva" />  como último elemento de la fila inferior del pie
//      (cliente = slug del repo, para medir visitas desde cada web; idioma="en" en las páginas en inglés)
interface Props { cliente: string; idioma?: 'es' | 'en' }
const { cliente, idioma = 'es' } = Astro.props;
const en = idioma === 'en';
const texto = en ? 'Made by' : 'Hecho por';
const etiqueta = en ? 'Made by Maná, web development studio (opens in a new tab)' : 'Hecho por Maná, estudio de desarrollo web (se abre en otra pestaña)';
const href = `https://manaestudio.ar/?utm_source=${encodeURIComponent(cliente)}&utm_medium=firma&utm_campaign=webs-clientes`;
---
  <a class="firma-mana" href={href} target="_blank" rel="noopener nofollow" aria-label={etiqueta} data-firma-mana>
    <span class="firma-mana-texto">{texto}</span>
    <svg class="firma-mana-logo" viewBox="0 2 252 80" aria-hidden="true" focusable="false">
      <path class="fm-letra" style="--i:0" fill="currentColor" d="M19.7 80L7.1 80L7.1 27.7L17.4 27.7L17.1 43.7L18.9 43.7Q20.3 37.9 22.6 34Q24.8 30.2 28.1 28.3Q31.4 26.4 35.7 26.4Q40.5 26.4 43.6 28.6Q46.7 30.8 48.4 34.6Q50 38.5 50.4 43.6L52 43.6Q53.3 37.8 55.8 34Q58.2 30.2 61.8 28.3Q65.3 26.4 69.6 26.4Q73.8 26.4 77 28.1Q80.2 29.8 82.4 33Q84.5 36.3 85.6 41.2Q86.6 46.1 86.6 52.5L86.6 80L73.9 80L73.9 54.1Q73.9 48.5 73 44.8Q72 41.1 70 39.3Q68.1 37.4 65 37.4Q61.5 37.4 58.9 39.7Q56.3 42 54.8 46.1Q53.3 50.3 53 55.6L53 80L40.6 80L40.6 54.7Q40.6 48.9 39.6 45Q38.6 41.2 36.6 39.3Q34.6 37.4 31.5 37.4Q27.9 37.4 25.4 39.8Q22.8 42.2 21.4 46.4Q19.9 50.6 19.7 55.8Z" />
      <path class="fm-letra" style="--i:1" fill="currentColor" d="M106.6 81.3Q102.3 81.3 98.9 79.7Q95.5 78 93.6 74.7Q91.6 71.4 91.6 66.5Q91.6 62.4 93.2 59.5Q94.7 56.6 97.8 54.8Q100.9 52.9 105.5 51.6Q110.1 50.4 116.3 49.5Q119.7 49 121.9 48.5Q124 48 125 46.9Q126 45.9 126 43.8Q126 40.7 123.9 38.4Q121.7 36.2 116.9 36.2Q114 36.2 111.4 37.2Q108.7 38.2 106.8 40.3Q104.9 42.5 104.2 46L92.9 42.5Q94 38.5 96.1 35.5Q98.2 32.6 101.3 30.5Q104.4 28.4 108.4 27.4Q112.4 26.4 117.2 26.4Q124.5 26.4 129.2 28.8Q133.9 31.1 136.2 36Q138.5 41 138.5 48.8L138.5 58.6Q138.5 62 138.7 65.7Q138.8 69.3 139.1 73Q139.3 76.6 139.7 80L128.4 80Q128 77.2 127.7 74Q127.4 70.8 127.2 67.5L125.6 67.5Q124.2 71.3 121.6 74.5Q119 77.6 115.3 79.5Q111.5 81.3 106.6 81.3ZM111.6 72Q113.6 72 115.7 71.3Q117.7 70.6 119.7 69.2Q121.7 67.8 123.4 65.8Q125.1 63.7 126.3 60.9L126.1 53.9Q125.3 54.3 124.3 54.6Q121.8 55.4 119.1 55.8Q116.3 56.2 113.6 56.8Q110.8 57.3 108.6 58.1Q106.4 59 105.1 60.5Q103.8 62.1 103.8 64.8Q103.8 68.2 106 70.1Q108.2 72 111.6 72Z" />
