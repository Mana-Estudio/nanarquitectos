      <path class="fm-letra" style="--i:3" fill="currentColor" d="M215.1 81.3Q210.8 81.3 207.4 79.7Q204 78 202.1 74.7Q200.1 71.4 200.1 66.5Q200.1 62.4 201.7 59.5Q203.2 56.6 206.3 54.8Q209.4 52.9 214 51.6Q218.6 50.4 224.8 49.5Q228.2 49 230.4 48.5Q232.5 48 233.5 46.9Q234.5 45.9 234.5 43.8Q234.5 40.7 232.4 38.4Q230.2 36.2 225.4 36.2Q222.5 36.2 219.9 37.2Q217.2 38.2 215.3 40.3Q213.4 42.5 212.7 46L201.4 42.5Q202.5 38.5 204.6 35.5Q206.7 32.6 209.8 30.5Q212.9 28.4 216.9 27.4Q220.9 26.4 225.7 26.4Q233 26.4 237.7 28.8Q242.4 31.1 244.7 36Q247 41 247 48.8L247 58.6Q247 62 247.2 65.7Q247.3 69.3 247.6 73Q247.8 76.6 248.2 80L236.9 80Q236.5 77.2 236.2 74Q235.9 70.8 235.7 67.5L234.1 67.5Q232.7 71.3 230.1 74.5Q227.5 77.6 223.8 79.5Q220 81.3 215.1 81.3ZM220.1 72Q222.1 72 224.2 71.3Q226.2 70.6 228.2 69.2Q230.2 67.8 231.9 65.8Q233.6 63.7 234.8 60.9L234.6 53.9Q233.8 54.3 232.8 54.6Q230.3 55.4 227.6 55.8Q224.8 56.2 222.1 56.8Q219.3 57.3 217.1 58.1Q214.9 59 213.6 60.5Q212.3 62.1 212.3 64.8Q212.3 68.2 214.5 70.1Q216.7 72 220.1 72Z" />
      <path class="fm-tilde" d="M232.8 3.8L222.5 20.3L212.6 20.3L220 3.8Z" />
    </svg>
  </a>

<script>
  // Marca la firma cuando entra en pantalla para lanzar la animación de llegada (una sola vez).
  const firmas = document.querySelectorAll<HTMLElement>('[data-firma-mana]');
  if (firmas.length && !matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entradas) => {
      for (const e of entradas) {
        if (!e.isIntersecting) continue;
        e.target.classList.add('fm-llega');
        io.unobserve(e.target);
      }
    }, { threshold: 0.6 });
    firmas.forEach((f) => {
      f.classList.add('fm-espera');
      io.observe(f);
      // Cuando termina la llegada queda en reposo: así al sacar el cursor no se repite.
      f.querySelector('.fm-tilde')?.addEventListener('animationend', () => f.classList.remove('fm-espera', 'fm-llega'), { once: true });
    });
  }
</script>

<style>
  .firma-mana {
    display: inline-flex;
    /* Alineado por la línea de base: el pie del logotipo apoya en la misma línea que «Hecho por». */
    align-items: baseline;
    gap: 0.45em;
    color: inherit;
    text-decoration: none;
    line-height: 1;
    /* Área táctil de 48 px (3rem) sin agrandar la fila: padding invisible compensado con margen negativo. */
    --fm-relleno: max(0px, calc((3rem - 1.3em) / 2));
    padding-block: var(--fm-relleno);
    margin-block: calc(var(--fm-relleno) * -1);
  }
  .firma-mana:hover, .firma-mana:focus-visible { text-decoration: none; }
  .firma-mana-logo { display: block; height: 1.3em; width: auto; overflow: visible; translate: 0 0.0325em; } /* el SVG apoya por su borde inferior; la base de las letras está 2/80 más arriba */
  .fm-letra, .fm-tilde { transform-box: fill-box; transform-origin: 50% 100%; }
  .fm-tilde { fill: #56b3f2; transform-origin: 50% 50%; }

  @media (prefers-reduced-motion: no-preference) {
    /* Llegada sutil: las letras suben en cascada y la tilde se posa. */
    .firma-mana.fm-espera .fm-letra { opacity: 0; transform: translateY(30%); }
    .firma-mana.fm-espera .fm-tilde { opacity: 0; transform: translateY(-120%); }
    .firma-mana.fm-llega .fm-letra { animation: fm-subir 550ms cubic-bezier(0.22, 1, 0.36, 1) calc(var(--i) * 60ms) both; }
    .firma-mana.fm-llega .fm-tilde { animation: fm-posar 650ms cubic-bezier(0.34, 1.4, 0.64, 1) 300ms both; }
    /* Cursor: una ola corta en las letras y la tilde se levanta un poco. */
    .firma-mana:hover .fm-letra, .firma-mana:focus-visible .fm-letra { animation: fm-ola 500ms ease-in-out calc(var(--i) * 55ms) both; }
    .firma-mana:hover .fm-tilde, .firma-mana:focus-visible .fm-tilde { animation: fm-salto 550ms cubic-bezier(0.34, 1.4, 0.64, 1) 150ms both; }
  }
  @keyframes fm-subir { from { opacity: 0; transform: translateY(30%); } to { opacity: 1; transform: none; } }
  @keyframes fm-posar { from { opacity: 0; transform: translateY(-120%); } to { opacity: 1; transform: none; } }
  @keyframes fm-ola { 0%, 100% { transform: none; } 40% { transform: translateY(-10%); } }
  @keyframes fm-salto { 0%, 100% { transform: none; } 50% { transform: translateY(-35%) rotate(-8deg); } }
</style>
