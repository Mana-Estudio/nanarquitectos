{
  "rewrites": [
    {
      "source": "/nanarquitectura",
      "destination": "/index.html"
    },
    {
      "source": "/nanarquitectura/",
      "destination": "/index.html"
    },
    {
      "source": "/nanarquitectura/:path*/",
      "destination": "/:path*/index.html"
    },
    {
      "source": "/nanarquitectura/:path*",
      "destination": "/:path*"
    }
  ]
}
